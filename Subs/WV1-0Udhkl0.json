[
  {
    "start": 0.12,
    "end": 4.12,
    "text": "Thưa quý vị, đây là những hình ảnh mới",
    "textdich": ""
  },
  {
    "start": 2.23,
    "end": 4.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 2.24,
    "end": 4.96,
    "text": "nhất từ nhà hưu của giáo phận Vinh. Mời",
    "textdich": ""
  },
  {
    "start": 4.11,
    "end": 4.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 4.12,
    "end": 7.799,
    "text": "quý vị cùng xem.",
    "textdich": ""
  },
  {
    "start": 4.95,
    "end": 7.799,
    "text": "",
    "textdich": ""
  },
  {
    "start": 4.96,
    "end": 12.2,
    "text": " Chắc chắn một điều, Chúa không làm điều",
    "textdich": ""
  },
  {
    "start": 7.789,
    "end": 12.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 7.799,
    "end": 15.2,
    "text": "ác, điều xấu, điều tội, điều sách",
    "textdich": ""
  },
  {
    "start": 12.19,
    "end": 15.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 12.2,
    "end": 19.72,
    "text": " và điều không thiện. Nó là việc của Chúa",
    "textdich": ""
  },
  {
    "start": 15.19,
    "end": 19.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 15.2,
    "end": 23.039,
    "text": "n. Nhưng mà gì? Có những lúc Chúa để cho",
    "textdich": ""
  },
  {
    "start": 19.71,
    "end": 23.039,
    "text": "",
    "textdich": ""
  },
  {
    "start": 19.72,
    "end": 26.4,
    "text": "điều ác, điều xấu, điều tội, điều sai",
    "textdich": ""
  },
  {
    "start": 23.029,
    "end": 26.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 23.039,
    "end": 29.84,
    "text": "của con người xảy ra để làm gì? Để Chúa",
    "textdich": ""
  },
  {
    "start": 26.39,
    "end": 29.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 26.4,
    "end": 33.64,
    "text": "tỏ lộ cái điều thái cho chúng ta.",
    "textdich": ""
  },
  {
    "start": 29.83,
    "end": 33.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 29.84,
    "end": 36.44,
    "text": "Cho nên là chúng ta nói là tìm ý Chúa",
    "textdich": ""
  },
  {
    "start": 33.63,
    "end": 36.44,
    "text": "",
    "textdich": ""
  },
  {
    "start": 33.64,
    "end": 39.28,
    "text": "hay là vâng theo thánh ý Chúa",
    "textdich": ""
  },
  {
    "start": 36.43,
    "end": 39.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 36.44,
    "end": 41.68,
    "text": "không phải là bất cứ quyết định nào của",
    "textdich": ""
  },
  {
    "start": 39.27,
    "end": 41.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 39.28,
    "end": 43.32,
    "text": "giáo hội hay của",
    "textdich": ""
  },
  {
    "start": 41.67,
    "end": 43.32,
    "text": "",
    "textdich": ""
  },
  {
    "start": 41.68,
    "end": 46.039,
    "text": "là y chúa.",
    "textdich": ""
  },
  {
    "start": 43.31,
    "end": 46.039,
    "text": "",
    "textdich": ""
  },
  {
    "start": 43.32,
    "end": 48.559,
    "text": " Và bởi vì để được được là ý bề trên hay",
    "textdich": ""
  },
  {
    "start": 46.029,
    "end": 48.559,
    "text": "",
    "textdich": ""
  },
  {
    "start": 46.039,
    "end": 50.44,
    "text": "là ý của giáo hội mà trở thành ý chúa đó",
    "textdich": ""
  },
  {
    "start": 48.549,
    "end": 50.44,
    "text": "",
    "textdich": ""
  },
  {
    "start": 48.559,
    "end": 52.199,
    "text": "thì phải có rất là nhiều điều kiện, phải",
    "textdich": ""
  },
  {
    "start": 50.43,
    "end": 52.199,
    "text": "",
    "textdich": ""
  },
  {
    "start": 50.44,
    "end": 55.399,
    "text": "đảm bảo rất là nhiều điều kiện. Nhưng mà",
    "textdich": ""
  },
  {
    "start": 52.189,
    "end": 55.399,
    "text": "",
    "textdich": ""
  },
  {
    "start": 52.199,
    "end": 58.039,
    "text": "vấn đề bất cứ ai nằm trong hàng cảnh đó,",
    "textdich": ""
  },
  {
    "start": 55.389,
    "end": 58.039,
    "text": "",
    "textdich": ""
  },
  {
    "start": 55.399,
    "end": 62.719,
    "text": "một người là nạn nhân của bất công, một",
    "textdich": ""
  },
  {
    "start": 58.029,
    "end": 62.719,
    "text": "",
    "textdich": ""
  },
  {
    "start": 58.039,
    "end": 65.4,
    "text": "người là nạn nhân của sự sai lệch",
    "textdich": ""
  },
  {
    "start": 62.709,
    "end": 65.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 62.719,
    "end": 68.88,
    "text": "thì cái người đó trong hoàn cảnh đó cũng",
    "textdich": ""
  },
  {
    "start": 65.39,
    "end": 68.88,
    "text": "",
    "textdich": ""
  },
  {
    "start": 65.4,
    "end": 71.24,
    "text": "có thể tìm ý Chúa và phải tìm ý Chúa.",
    "textdich": ""
  },
  {
    "start": 68.87,
    "end": 71.24,
    "text": "",
    "textdich": ""
  },
  {
    "start": 68.88,
    "end": 73.4,
    "text": " Đó mới là điều đúng. Ừ. Tức là chẳng hạn",
    "textdich": ""
  },
  {
    "start": 71.23,
    "end": 73.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 71.24,
    "end": 77.159,
    "text": "như mình là một nạn nhân kể ",
    "textdich": ""
  },
  {
    "start": 73.39,
    "end": 77.159,
    "text": "",
    "textdich": ""
  },
  {
    "start": 73.4,
    "end": 77.159,
    "text": "cả nạn nhân của giá hội đi.",
    "textdich": ""
  }
]