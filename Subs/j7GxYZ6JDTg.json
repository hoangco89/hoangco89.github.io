[
  {
    "start": 0.08,
    "end": 3.919,
    "text": "điều gì xảy ra khi mà chúng ta ăn lá mưa",
    "textdich": ""
  },
  {
    "start": 2.03,
    "end": 3.919,
    "text": "",
    "textdich": ""
  },
  {
    "start": 2.04,
    "end": 5.4,
    "text": "lông hàng ngày để mà ăn lá mưa lông hàng",
    "textdich": ""
  },
  {
    "start": 3.909,
    "end": 5.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 3.919,
    "end": 7.0,
    "text": "ngày thì nó hơi khó nhưng mà đông y thì",
    "textdich": ""
  },
  {
    "start": 5.39,
    "end": 7.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 5.4,
    "end": 9.28,
    "text": "hay áp dụng bằng cách là uống lá mưa",
    "textdich": ""
  },
  {
    "start": 6.99,
    "end": 9.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 7.0,
    "end": 11.2,
    "text": "lông hàng ngày thì trong đông y của bác",
    "textdich": ""
  },
  {
    "start": 9.27,
    "end": 11.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 9.28,
    "end": 13.44,
    "text": "sĩ Hoa cái lá mưa lông mà mọi người hay",
    "textdich": ""
  },
  {
    "start": 11.19,
    "end": 13.44,
    "text": "",
    "textdich": ""
  },
  {
    "start": 11.2,
    "end": 15.559,
    "text": "ăn với thịt chó ấy nó sẽ có cái tính mát",
    "textdich": ""
  },
  {
    "start": 13.43,
    "end": 15.559,
    "text": "",
    "textdich": ""
  },
  {
    "start": 13.44,
    "end": 17.119,
    "text": "thì chó thì nó nóng mà lá mưa lông thì",
    "textdich": ""
  },
  {
    "start": 15.549,
    "end": 17.119,
    "text": "",
    "textdich": ""
  },
  {
    "start": 15.559,
    "end": 19.08,
    "text": "nó có tính mát nên là nó sẽ trung hòa",
    "textdich": ""
  },
  {
    "start": 17.109,
    "end": 19.08,
    "text": "",
    "textdich": ""
  },
  {
    "start": 17.119,
    "end": 21.519,
    "text": "lại được với hai nữa là cái lá mưa lông",
    "textdich": ""
  },
  {
    "start": 19.07,
    "end": 21.519,
    "text": "",
    "textdich": ""
  },
  {
    "start": 19.08,
    "end": 23.4,
    "text": "này nó có tính khu Phong nó sẽ trừ được",
    "textdich": ""
  },
  {
    "start": 21.509,
    "end": 23.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 21.519,
    "end": 25.84,
    "text": "phong thấp tiêu thũng giải độc và giảm",
    "textdich": ""
  },
  {
    "start": 23.39,
    "end": 25.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 23.4,
    "end": 27.08,
    "text": "đau giảm viêm nên trong nó sẽ được sử",
    "textdich": ""
  },
  {
    "start": 25.83,
    "end": 27.08,
    "text": "",
    "textdich": ""
  },
  {
    "start": 25.84,
    "end": 28.76,
    "text": "dụng nhiều nhất trong những cái trường",
    "textdich": ""
  },
  {
    "start": 27.07,
    "end": 28.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 27.08,
    "end": 31.119,
    "text": "hợp mà mọi người có những cái bệnh đại",
    "textdich": ""
  },
  {
    "start": 28.75,
    "end": 31.119,
    "text": "",
    "textdich": ""
  },
  {
    "start": 28.76,
    "end": 33.28,
    "text": "tràng liên quan tới nhị nhệt đấy là lý",
    "textdich": ""
  },
  {
    "start": 31.109,
    "end": 33.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 31.119,
    "end": 35.04,
    "text": "do vì sao mà những cái ai mà hay bị mắc",
    "textdich": ""
  },
  {
    "start": 33.27,
    "end": 35.04,
    "text": "",
    "textdich": ""
  },
  {
    "start": 33.28,
    "end": 36.719,
    "text": "bệnh viêm đại tràng này viêm ruột kích",
    "textdich": ""
  },
  {
    "start": 35.03,
    "end": 36.719,
    "text": "",
    "textdich": ""
  },
  {
    "start": 35.04,
    "end": 38.28,
    "text": "thích này bị đi ngoài phân lỏng này hay",
    "textdich": ""
  },
  {
    "start": 36.709,
    "end": 38.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 36.719,
    "end": 39.879,
    "text": "là có những cái vấn đề về đại tràng đều",
    "textdich": ""
  },
  {
    "start": 38.27,
    "end": 39.879,
    "text": "",
    "textdich": ""
  },
  {
    "start": 38.28,
    "end": 41.84,
    "text": "sẽ được khuyên là Ăn nhiều lá mưa lông",
    "textdich": ""
  },
  {
    "start": 39.869,
    "end": 41.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 39.879,
    "end": 44.52,
    "text": "lên bởi vì nó có thể có cái tác dụng mà",
    "textdich": ""
  },
  {
    "start": 41.83,
    "end": 44.52,
    "text": "",
    "textdich": ""
  },
  {
    "start": 41.84,
    "end": 46.12,
    "text": "nó tiêu độc tiêu thũng và nó làm mát",
    "textdich": ""
  },
  {
    "start": 44.51,
    "end": 46.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 44.52,
    "end": 47.52,
    "text": "được cái vùng đại tràng của mọi người",
    "textdich": ""
  },
  {
    "start": 46.11,
    "end": 47.52,
    "text": "",
    "textdich": ""
  },
  {
    "start": 46.12,
    "end": 49.12,
    "text": "thì bằng cách đơn giản nhất là mọi người",
    "textdich": ""
  },
  {
    "start": 47.51,
    "end": 49.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 47.52,
    "end": 51.079,
    "text": "sẽ hái cái lá môa lông đấy chúng ta ăn",
    "textdich": ""
  },
  {
    "start": 49.11,
    "end": 51.079,
    "text": "",
    "textdich": ""
  },
  {
    "start": 49.12,
    "end": 53.399,
    "text": "trực tiếp này hoặc là chúng ta sẽ hấp",
    "textdich": ""
  },
  {
    "start": 51.069,
    "end": 53.399,
    "text": "",
    "textdich": ""
  },
  {
    "start": 51.079,
    "end": 55.6,
    "text": "với trứng này hoặc là chúng ta lấy cái",
    "textdich": ""
  },
  {
    "start": 53.389,
    "end": 55.6,
    "text": "",
    "textdich": ""
  },
  {
    "start": 53.399,
    "end": 57.28,
    "text": "lá đấy chúng ta đun lấy nước uống nhưng",
    "textdich": ""
  },
  {
    "start": 55.59,
    "end": 57.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 55.6,
    "end": 60.199,
    "text": "mà cái liều lượng nó sẽ rơi vào khoảng",
    "textdich": ""
  },
  {
    "start": 57.27,
    "end": 60.199,
    "text": "",
    "textdich": ""
  },
  {
    "start": 57.28,
    "end": 62.0,
    "text": "tầm từ 20 cho tới 30 g đấy là lá Lá Khô",
    "textdich": ""
  },
  {
    "start": 60.189,
    "end": 62.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 60.199,
    "end": 64.239,
    "text": "còn lá tươi thì mọi người có thể sẽ phải",
    "textdich": ""
  },
  {
    "start": 61.99,
    "end": 64.239,
    "text": "",
    "textdich": ""
  },
  {
    "start": 62.0,
    "end": 66.36,
    "text": "dùng tới khoảng tầm cả 100 g cho tới 200",
    "textdich": ""
  },
  {
    "start": 64.229,
    "end": 66.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 64.239,
    "end": 67.68,
    "text": "g một ngày à trong những trường hợp mà",
    "textdich": ""
  },
  {
    "start": 66.35,
    "end": 67.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 66.36,
    "end": 69.2,
    "text": "không phải lúc nào chúng ta cũng dễ dàng",
    "textdich": ""
  },
  {
    "start": 67.67,
    "end": 69.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 67.68,
    "end": 71.24,
    "text": "lấy lá mơ lông ấ thì mọi người có thể",
    "textdich": ""
  },
  {
    "start": 69.19,
    "end": 71.24,
    "text": "",
    "textdich": ""
  },
  {
    "start": 69.2,
    "end": 72.84,
    "text": "lấy ở bên ngoài chúng ta phơi khô đi và",
    "textdich": ""
  },
  {
    "start": 71.23,
    "end": 72.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 71.24,
    "end": 75.4,
    "text": "cất đi dùng dần mỗi ngày dùng khoảng tầm",
    "textdich": ""
  },
  {
    "start": 72.83,
    "end": 75.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 72.84,
    "end": 77.4,
    "text": "20 cho tới 30 g ngoài cái tác dụng Điền",
    "textdich": ""
  },
  {
    "start": 75.39,
    "end": 77.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 75.4,
    "end": 79.4,
    "text": "hình nhất và có cái tác dụng thực sự",
    "textdich": ""
  },
  {
    "start": 77.39,
    "end": 79.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 77.4,
    "end": 81.479,
    "text": "kiểu nhanh ấy đối với những cái trường",
    "textdich": ""
  },
  {
    "start": 79.39,
    "end": 81.479,
    "text": "",
    "textdich": ""
  },
  {
    "start": 79.4,
    "end": 83.56,
    "text": "trường hợp mà bị viêm đại tràng ấy thì",
    "textdich": ""
  },
  {
    "start": 81.469,
    "end": 83.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 81.479,
    "end": 85.68,
    "text": "mọi người cũng có thể là thấy là những",
    "textdich": ""
  },
  {
    "start": 83.55,
    "end": 85.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 83.56,
    "end": 88.32,
    "text": "cái em bé ngày xưa mà các bé kiểu hay",
    "textdich": ""
  },
  {
    "start": 85.67,
    "end": 88.32,
    "text": "",
    "textdich": ""
  },
  {
    "start": 85.68,
    "end": 90.04,
    "text": "còi cọc suy dinh dưỡng mà lúc đấy cái y",
    "textdich": ""
  },
  {
    "start": 88.31,
    "end": 90.04,
    "text": "",
    "textdich": ""
  },
  {
    "start": 88.32,
    "end": 92.799,
    "text": "tế chưa phát triển thì có thể lấy cái lá",
    "textdich": ""
  },
  {
    "start": 90.03,
    "end": 92.799,
    "text": "",
    "textdich": ""
  },
  {
    "start": 90.04,
    "end": 94.64,
    "text": "mơ lông này với trứng xong đảo với trứng",
    "textdich": ""
  },
  {
    "start": 92.789,
    "end": 94.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 92.799,
    "end": 96.2,
    "text": "cho các bé ăn để nó cải thiện cái vấn đề",
    "textdich": ""
  },
  {
    "start": 94.63,
    "end": 96.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 94.64,
    "end": 98.04,
    "text": "tiêu hóa của các bé đấy nhưng mà bây giờ",
    "textdich": ""
  },
  {
    "start": 96.19,
    "end": 98.04,
    "text": "",
    "textdich": ""
  },
  {
    "start": 96.2,
    "end": 99.399,
    "text": "thì chúng đối với những cái những cái bé",
    "textdich": ""
  },
  {
    "start": 98.03,
    "end": 99.399,
    "text": "",
    "textdich": ""
  },
  {
    "start": 98.04,
    "end": 100.56,
    "text": "đấy thì có thể ăn tăng cường lên nhưng",
    "textdich": ""
  },
  {
    "start": 99.389,
    "end": 100.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 99.399,
    "end": 102.6,
    "text": "mà bây giờ chúng ta cũng có rất nhiều",
    "textdich": ""
  },
  {
    "start": 100.55,
    "end": 102.6,
    "text": "",
    "textdich": ""
  },
  {
    "start": 100.56,
    "end": 103.92,
    "text": "những cái thuốc đi kèm để chữa rồi à hay",
    "textdich": ""
  },
  {
    "start": 102.59,
    "end": 103.92,
    "text": "",
    "textdich": ""
  },
  {
    "start": 102.6,
    "end": 105.56,
    "text": "là trong những trường hợp mà chúng ta có",
    "textdich": ""
  },
  {
    "start": 103.91,
    "end": 105.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 103.92,
    "end": 107.719,
    "text": "đau mỏi xương khớp hoàn toàn cũng có thể",
    "textdich": ""
  },
  {
    "start": 105.55,
    "end": 107.719,
    "text": "",
    "textdich": ""
  },
  {
    "start": 105.56,
    "end": 109.399,
    "text": "ăn tăng cái mơ lông lên Ngày xưa thì cái",
    "textdich": ""
  },
  {
    "start": 107.709,
    "end": 109.399,
    "text": "",
    "textdich": ""
  },
  {
    "start": 107.719,
    "end": 111.2,
    "text": "m lá mơ lông còn được sử dụng trong",
    "textdich": ""
  },
  {
    "start": 109.389,
    "end": 111.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 109.399,
    "end": 112.759,
    "text": "những trường hợp chúng ta bị đau dạ dày",
    "textdich": ""
  },
  {
    "start": 111.19,
    "end": 112.759,
    "text": "",
    "textdich": ""
  },
  {
    "start": 111.2,
    "end": 115.719,
    "text": "hay là chúng ta có những cái kiểu ho lao",
    "textdich": ""
  },
  {
    "start": 112.749,
    "end": 115.719,
    "text": "",
    "textdich": ""
  },
  {
    "start": 112.759,
    "end": 117.399,
    "text": "ho khan hay là có hỗ trợ để tẩy giun",
    "textdich": ""
  },
  {
    "start": 115.709,
    "end": 117.399,
    "text": "",
    "textdich": ""
  },
  {
    "start": 115.719,
    "end": 119.6,
    "text": "nhưng mà bây giờ thì nó còn không còn",
    "textdich": ""
  },
  {
    "start": 117.389,
    "end": 119.6,
    "text": "",
    "textdich": ""
  },
  {
    "start": 117.399,
    "end": 121.0,
    "text": "thực tế nữa bởi vì đợi mà uống lá mưa",
    "textdich": ""
  },
  {
    "start": 119.59,
    "end": 121.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 119.6,
    "end": 122.479,
    "text": "lông xong đấy để cho những cái lo con",
    "textdich": ""
  },
  {
    "start": 120.99,
    "end": 122.479,
    "text": "",
    "textdich": ""
  },
  {
    "start": 121.0,
    "end": 123.799,
    "text": "giun nó ra thì nó quá là khó và nó không",
    "textdich": ""
  },
  {
    "start": 122.469,
    "end": 123.799,
    "text": "",
    "textdich": ""
  },
  {
    "start": 122.479,
    "end": 125.479,
    "text": "hết hoàn toàn bây giờ chúng ta uống một",
    "textdich": ""
  },
  {
    "start": 123.789,
    "end": 125.479,
    "text": "",
    "textdich": ""
  },
  {
    "start": 123.799,
    "end": 127.119,
    "text": "phát liều thuốc giun là xong đúng không",
    "textdich": ""
  },
  {
    "start": 125.469,
    "end": 127.119,
    "text": "",
    "textdich": ""
  },
  {
    "start": 125.479,
    "end": 128.599,
    "text": "Hay là chúng ta có cái tình trạng mà bị",
    "textdich": ""
  },
  {
    "start": 127.109,
    "end": 128.599,
    "text": "",
    "textdich": ""
  },
  {
    "start": 127.119,
    "end": 130.64,
    "text": "viêm đau dạ dày thì bây giờ cũng có",
    "textdich": ""
  },
  {
    "start": 128.589,
    "end": 130.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 128.599,
    "end": 133.16,
    "text": "thuốc nó nhanh hơn thì nó cũng đã bị xao",
    "textdich": ""
  },
  {
    "start": 130.63,
    "end": 133.16,
    "text": "",
    "textdich": ""
  },
  {
    "start": 130.64,
    "end": 136.44,
    "text": "nhãng đi nhiều rồi nhưng để có thể cùng",
    "textdich": ""
  },
  {
    "start": 133.15,
    "end": 136.44,
    "text": "",
    "textdich": ""
  },
  {
    "start": 133.16,
    "end": 138.08,
    "text": "với hỗ trợ cho cái việc cải thiện giữ",
    "textdich": ""
  },
  {
    "start": 136.43,
    "end": 138.08,
    "text": "",
    "textdich": ""
  },
  {
    "start": 136.44,
    "end": 139.599,
    "text": "được cái lúc sau mà mọi người điều trị",
    "textdich": ""
  },
