[
  {
    "start": 2.399,
    "end": 8.0,
    "text": "Nếu tôi hỏi bạn toán học là gì, bạn sẽ",
    "textdich": ""
  },
  {
    "start": 5.749,
    "end": 8.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 5.759,
    "end": 9.96,
    "text": "trả lời thế nào? Rất có thể câu trả lời",
    "textdich": ""
  },
  {
    "start": 7.99,
    "end": 9.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 8.0,
    "end": 12.799,
    "text": "của bạn sẽ xoay quanh những phép tính,",
    "textdich": ""
  },
  {
    "start": 9.95,
    "end": 12.799,
    "text": "",
    "textdich": ""
  },
  {
    "start": 9.96,
    "end": 15.0,
    "text": "giải phương trình, đạo hàm, tích phân,",
    "textdich": ""
  },
  {
    "start": 12.789,
    "end": 15.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 12.799,
    "end": 18.0,
    "text": "những con số, những công thức, những bài",
    "textdich": ""
  },
  {
    "start": 14.99,
    "end": 18.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 15.0,
    "end": 19.64,
    "text": "kiểm tra 15 phút đầy áp lực. Nhưng nếu",
    "textdich": ""
  },
  {
    "start": 17.99,
    "end": 19.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 18.0,
    "end": 21.68,
    "text": "tôi nói với bạn rằng  từng có",
    "textdich": ""
  },
  {
    "start": 19.63,
    "end": 21.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 19.64,
    "end": 23.48,
    "text": "một giai đoạn trong lịch sử, người ta đã",
    "textdich": ""
  },
  {
    "start": 21.67,
    "end": 23.48,
    "text": "",
    "textdich": ""
  },
  {
    "start": 21.68,
    "end": 25.48,
    "text": "thật sự cố gắng dạy học sinh một thứ",
    "textdich": ""
  },
  {
    "start": 23.47,
    "end": 25.48,
    "text": "",
    "textdich": ""
  },
  {
    "start": 23.48,
    "end": 27.88,
    "text": "hoàn toàn khác, không phải cách tính",
    "textdich": ""
  },
  {
    "start": 25.47,
    "end": 27.88,
    "text": "",
    "textdich": ""
  },
  {
    "start": 25.48,
    "end": 29.56,
    "text": "toán mà là bản chất của tư duy toán học",
    "textdich": ""
  },
  {
    "start": 27.87,
    "end": 29.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 27.88,
    "end": 32.48,
    "text": "thì sao?",
    "textdich": ""
  },
  {
    "start": 29.55,
    "end": 32.48,
    "text": "",
    "textdich": ""
  },
  {
    "start": 29.56,
    "end": 33.879,
    "text": "Và rồi chính phụ huynh, chính giáo viên,",
    "textdich": ""
  },
  {
    "start": 32.47,
    "end": 33.879,
    "text": "",
    "textdich": ""
  },
  {
    "start": 32.48,
    "end": 37.04,
    "text": "chính cả  một quốc gia đã đứng",
    "textdich": ""
  },
  {
    "start": 33.869,
    "end": 37.04,
    "text": "",
    "textdich": ""
  },
  {
    "start": 33.879,
    "end": 39.28,
    "text": "lên phản đối nó đến mức nó bị dẹp bỏ",
    "textdich": ""
  },
  {
    "start": 37.03,
    "end": 39.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 37.04,
    "end": 40.2,
    "text": "hoàn toàn. Đây không phải là một giả",
    "textdich": ""
  },
  {
    "start": 39.27,
    "end": 40.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 39.28,
    "end": 43.079,
    "text": "thuyết, ",
    "textdich": ""
  },
  {
    "start": 40.19,
    "end": 43.079,
    "text": "",
    "textdich": ""
  },
  {
    "start": 40.2,
    "end": 45.16,
    "text": "đây là chuyện đã thật sự xảy ra.",
    "textdich": ""
  },
  {
    "start": 43.069,
    "end": 45.16,
    "text": "",
    "textdich": ""
  },
  {
    "start": 43.079,
    "end": 47.96,
    "text": "Vậy điều gì đã khiến một nỗ lực dạy toán",
    "textdich": ""
  },
  {
    "start": 45.15,
    "end": 47.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 45.16,
    "end": 50.399,
    "text": "học thật lại thất bại đến vậy? Và quan",
    "textdich": ""
  },
  {
    "start": 47.95,
    "end": 50.399,
    "text": "",
    "textdich": ""
  },
  {
    "start": 47.96,
    "end": 52.239,
    "text": "trọng hơn, liệu hậu quả của thất bại đó",
    "textdich": ""
  },
  {
    "start": 50.389,
    "end": 52.239,
    "text": "",
    "textdich": ""
  },
  {
    "start": 50.399,
    "end": 54.64,
    "text": "có đang âm thầm định hình cách bạn học",
    "textdich": ""
  },
  {
    "start": 52.229,
    "end": 54.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 52.239,
    "end": 56.239,
    "text": "toán suốt 12 năm phổ thông ngay lúc này",
    "textdich": ""
  },
  {
    "start": 54.63,
    "end": 56.239,
    "text": "",
    "textdich": ""
  },
  {
    "start": 54.64,
    "end": 58.12,
    "text": "hay không?",
    "textdich": ""
  },
  {
    "start": 56.229,
    "end": 58.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 56.239,
    "end": 61.719,
    "text": "Để trả lời,  chúng ta cần quay",
    "textdich": ""
  },
  {
    "start": 58.11,
    "end": 61.719,
    "text": "",
    "textdich": ""
  },
  {
    "start": 58.12,
    "end": 63.92,
    "text": "ngược về một đêm tháng 10 năm 1957",
    "textdich": ""
  },
  {
    "start": 61.709,
    "end": 63.92,
    "text": "",
    "textdich": ""
  },
  {
    "start": 61.719,
    "end": 69.2,
    "text": "khi cả nước Mỹ ngước nhìn lên bầu trời",
    "textdich": ""
  },
  {
    "start": 63.91,
    "end": 69.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 63.92,
    "end": 69.2,
    "text": "và nhận ra họ đang tụt lại phía sau.",
    "textdich": ""
  },
  {
    "start": 73.07,
    "end": 73.07,
    "text": "",
    "textdich": ""
  },
  {
    "start": 73.08,
    "end": 77.29,
    "text": "Ngày 4 tháng 10 năm 1957,",
    "textdich": ""
  },
  {
    "start": 75.789,
    "end": 77.29,
    "text": "",
    "textdich": ""
  },
  {
    "start": 75.799,
    "end": 78.0,
    "text": "Liên Xô phóng thành công Spartnick,",
    "textdich": ""
  },
  {
    "start": 77.28,
    "end": 78.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 77.29,
    "end": 79.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 77.99,
    "end": 79.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 78.0,
    "end": 81.6,
    "text": "vệ tinh nhân tạo đầu tiên của loài người",
    "textdich": ""
  },
  {
    "start": 79.83,
    "end": 81.6,
    "text": "",
    "textdich": ""
  },
  {
    "start": 79.84,
    "end": 83.4,
    "text": "bay quanh Trái Đất.",
    "textdich": ""
  },
  {
    "start": 81.59,
    "end": 83.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 81.6,
    "end": 86.28,
    "text": "Với nước Mỹ, đây không chỉ là một cột",
    "textdich": ""
  },
  {
    "start": 83.39,
    "end": 86.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 83.4,
    "end": 88.36,
    "text": "mốc khoa học, đó là một cú sốc. Trong",
    "textdich": ""
  },
  {
    "start": 86.27,
    "end": 88.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 86.28,
    "end": 91.36,
    "text": "suốt chiến tranh lạnh, người Mỹ luôn tin",
    "textdich": ""
  },
  {
    "start": 88.35,
    "end": 91.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 88.36,
    "end": 93.24,
    "text": "rằng mình dẫn đầu về công nghệ. Sputnck",
    "textdich": ""
  },
  {
    "start": 91.35,
    "end": 93.24,
    "text": "",
    "textdich": ""
  },
  {
    "start": 91.36,
    "end": 96.286,
    "text": "chứng minh điều ngược lại và ngay lập",
    "textdich": ""
  },
  {
    "start": 93.23,
    "end": 96.286,
    "text": "",
    "textdich": ""
  },
  {
    "start": 93.24,
    "end": 98.68,
    "text": "tức câu hỏi được đặt ra tại sao Liên Xô",
    "textdich": ""
  },
  {
    "start": 96.276,
    "end": 98.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 96.286,
    "end": 101.399,
    "text": " lại vượt mặt được nước Mỹ? Câu",
    "textdich": ""
  },
  {
    "start": 98.67,
    "end": 101.399,
    "text": "",
    "textdich": ""
  },
  {
    "start": 98.68,
    "end": 104.719,
    "text": "trả lời mà giới lãnh đạo Mỹ đưa ra, vấn",
    "textdich": ""
  },
  {
    "start": 101.389,
    "end": 104.719,
    "text": "",
    "textdich": ""
  },
  {
    "start": 101.399,
    "end": 106.68,
    "text": "đề nằm ở giáo dục, cụ thể hơn, nằm ở",
    "textdich": ""
  },
  {
    "start": 104.709,
    "end": 106.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 104.719,
    "end": 108.719,
    "text": "cách nước Mỹ đang dạy toán và khoa học",
    "textdich": ""
  },
  {
    "start": 106.67,
    "end": 108.719,
    "text": "",
    "textdich": ""
  },
  {
    "start": 106.68,
    "end": 110.56,
    "text": "cho  học sinh. Cách dạy toán",
    "textdich": ""
  },
  {
    "start": 108.709,
    "end": 110.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 108.719,
    "end": 112.799,
    "text": "truyền thống lúc đó tập trung gần như",
    "textdich": ""
  },
  {
    "start": 110.55,
    "end": 112.799,
    "text": "",
    "textdich": ""
  },
  {
    "start": 110.56,
    "end": 115.56,
    "text": "hoàn toàn vào tính toán và ghi nhớ công",
    "textdich": ""
  },
  {
    "start": 112.789,
    "end": 115.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 112.799,
    "end": 117.88,
    "text": "thức. Học sinh học cách ra đáp số đúng",
    "textdich": ""
  },
  {
    "start": 115.55,
    "end": 117.88,
    "text": "",
    "textdich": ""
  },
  {
    "start": 115.56,
    "end": 120.92,
    "text": "nhưng hiếm khi được dạy vì sao công thức",
    "textdich": ""
  },
  {
    "start": 117.87,
    "end": 120.92,
    "text": "",
    "textdich": ""
  },
  {
    "start": 117.88,
    "end": 124.2,
    "text": "đó đúng hay bản chất logic đằng sau nó",
    "textdich": ""
  },
  {
    "start": 120.91,
    "end": 124.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 120.92,
    "end": 126.416,
    "text": "là gì. Với giới khoa học, đây chính là",
    "textdich": ""
  },
  {
    "start": 124.19,
    "end": 126.416,
    "text": "",
    "textdich": ""
  },
  {
    "start": 124.2,
    "end": 128.319,
    "text": "lỗ hổng vì những nhà toán học, nhà vật",
    "textdich": ""
  },
  {
    "start": 126.406,
    "end": 128.319,
    "text": "",
    "textdich": ""
  },
  {
    "start": 126.416,
    "end": 130.879,
    "text": " lý thực thụ không làm việc",
    "textdich": ""
  },
  {
    "start": 128.309,
    "end": 130.879,
    "text": "",
    "textdich": ""
  },
  {
    "start": 128.319,
    "end": 132.959,
    "text": "bằng cách áp công thức có sẵn. Họ tư duy",
    "textdich": ""
  },
  {
    "start": 130.869,
    "end": 132.959,
    "text": "",
    "textdich": ""
  },
  {
    "start": 130.879,
    "end": 135.36,
    "text": "bằng cấu trúc, bằng chứng minh, bằng",
    "textdich": ""
  },
  {
    "start": 132.949,
    "end": 135.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 132.959,
    "end": 137.551,
    "text": "logic trừu tưởng.",
    "textdich": ""
  },
  {
    "start": 135.35,
    "end": 137.551,
    "text": "",
    "textdich": ""
  },
  {
    "start": 135.36,
    "end": 140.239,
    "text": "Chưa đầy một năm sau, ngày 2 tháng",
    "textdich": ""
  },
  {
    "start": 137.541,
    "end": 140.239,
    "text": "",
    "textdich": ""
  },
  {
    "start": 137.551,
    "end": 142.48,
    "text": " năm 1958, Tổng thống",
    "textdich": ""
  },
  {
    "start": 140.229,
    "end": 142.48,
    "text": "",
    "textdich": ""
  },
  {
    "start": 140.239,
    "end": 144.756,
    "text": "Eisenhauer ký ban hành đạo luật giáo dục",
    "textdich": ""
  },
  {
    "start": 142.47,
    "end": 144.756,
    "text": "",
    "textdich": ""
  },
  {
    "start": 142.48,
    "end": 146.68,
    "text": "quốc phòng National Defense Education",
    "textdich": ""
  },
  {
    "start": 144.746,
    "end": 146.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 144.756,
    "end": 148.92,
    "text": " Act.",
    "textdich": ""
  },
  {
    "start": 146.67,
    "end": 148.92,
    "text": "",
    "textdich": ""
  },
  {
    "start": 146.68,
    "end": 150.8,
    "text": "Đạo luật này rót hơn 1 tỷ đô la vào việc",
    "textdich": ""
  },
  {
    "start": 148.91,
    "end": 150.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 148.92,
    "end": 153.28,
    "text": "cải tổ giáo dục toán  học, khoa",
    "textdich": ""
  },
  {
    "start": 150.79,
    "end": 153.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 150.8,
    "end": 155.891,
    "text": "học và ngoại ngữ trên toàn nước Mỹ. Một",
    "textdich": ""
  },
  {
    "start": 153.27,
    "end": 155.891,
    "text": "",
    "textdich": ""
  },
  {
    "start": 153.28,
    "end": 157.08,
    "text": "con số khổng lồ vào thời điểm đó và là",
    "textdich": ""
  },
  {
    "start": 155.881,
    "end": 157.08,
    "text": "",
    "textdich": ""
  },
  {
    "start": 155.891,
    "end": 159.879,
    "text": " lần đầu tiên chính phủ Liên",
    "textdich": ""
  },
  {
    "start": 157.07,
    "end": 159.879,
    "text": "",
    "textdich": ""
  },
  {
    "start": 157.08,
    "end": 162.84,
    "text": "bang Mỹ can thiệp sâu đến vậy vào chương",
    "textdich": ""
  },
  {
    "start": 159.869,
    "end": 162.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 159.879,
    "end": 164.599,
    "text": "trình giảng dạy tại trường học.",
    "textdich": ""
  },
  {
    "start": 162.83,
    "end": 164.599,
    "text": "",
    "textdich": ""
  },
  {
    "start": 162.84,
    "end": 167.12,
    "text": "Dòng tiền  này đổ vào hàng loạt",
    "textdich": ""
  },
  {
    "start": 164.589,
    "end": 167.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 164.599,
    "end": 168.879,
    "text": "tổ chức cải cách giáo dục toán học. Sớm",
    "textdich": ""
  },
  {
    "start": 167.11,
    "end": 168.879,
    "text": "",
    "textdich": ""
  },
  {
    "start": 167.12,
    "end": 170.64,
    "text": "nhất là Ủy ban toán học trường học của",
    "textdich": ""
  },
  {
    "start": 168.869,
    "end": 170.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 168.879,
    "end": 172.76,
    "text": "Đại  học Illinois do nhà toán",
    "textdich": ""
  },
  {
    "start": 170.63,
    "end": 172.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 170.64,
    "end": 175.76,
    "text": "học Max Biberman khởi xướng từ đầu thập",
    "textdich": ""
  },
  {
    "start": 172.75,
    "end": 175.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 172.76,
    "end": 177.92,
    "text": "niên 1950.  Nhưng tổ chức có",
    "textdich": ""
  },
  {
    "start": 175.75,
    "end": 177.92,
    "text": "",
    "textdich": ""
  },
  {
    "start": 175.76,
    "end": 179.92,
    "text": "ảnh hưởng lớn nhất ra đời ngay sau cú",
    "textdich": ""
  },
  {
    "start": 177.91,
    "end": 179.92,
    "text": "",
    "textdich": ""
  },
  {
    "start": 177.92,
    "end": 182.4,
    "text": "sốc Spartnick là  School",
    "textdich": ""
  },
  {
    "start": 179.91,
    "end": 182.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 179.92,
    "end": 184.68,
    "text": "Mathematics Study Group do nhà toán học",
    "textdich": ""
  },
  {
    "start": 182.39,
    "end": 184.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 182.4,
    "end": 185.367,
    "text": "Edward Bagel dẫn dắt. Mục tiêu của họ",
    "textdich": ""
  },
  {
    "start": 184.67,
    "end": 185.367,
    "text": "",
    "textdich": ""
  },
  {
    "start": 184.68,
    "end": 185.48,
    "text": "không hề nhỏ.",
    "textdich": ""
  },
  {
    "start": 185.357,
    "end": 185.48,
    "text": "",
    "textdich": ""
  },
  {
    "start": 185.367,
    "end": 187.599,
    "text": " ",
    "textdich": ""
  },
  {
    "start": 185.47,
    "end": 187.599,
    "text": "",
    "textdich": ""
  },
  {
    "start": 185.48,
    "end": 189.68,
    "text": " viết lại toàn bộ cách nước Mỹ dạy toán",
    "textdich": ""
  },
  {
    "start": 187.589,
    "end": 189.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 187.599,
    "end": 191.159,
    "text": "từ tiểu học đến trung học theo một triết",
    "textdich": ""
  },
  {
    "start": 189.67,
    "end": 191.159,
    "text": "",
    "textdich": ""
  },
  {
    "start": 189.68,
    "end": 193.159,
    "text": "lý hoàn toàn mới. ",
    "textdich": ""
  },
  {
    "start": 191.149,
    "end": 193.159,
    "text": "",
    "textdich": ""
  },
  {
    "start": 191.159,
    "end": 197.879,
    "text": "Một phong trào sau này được biết đến với",
    "textdich": ""
  },
  {
    "start": 193.149,
    "end": 197.879,
    "text": "",
    "textdich": ""
  },
  {
    "start": 193.159,
    "end": 197.879,
    "text": "cái tên New Math.",
    "textdich": ""
  },
  {
    "start": 202.27,
    "end": 202.27,
    "text": "",
    "textdich": ""
  },
  {
    "start": 202.28,
    "end": 206.84,
    "text": "Vậy New Math thực chất dạy học sinh",
    "textdich": ""
  },
  {
    "start": 204.07,
    "end": 206.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 204.08,
    "end": 209.12,
    "text": "những gì?  Thay vì bắt đầu bằng",
    "textdich": ""
  },
  {
    "start": 206.83,
    "end": 209.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 206.84,
    "end": 210.72,
    "text": "bảng cửu trương và các phép tính cơ bản,",
    "textdich": ""
  },
  {
    "start": 209.11,
    "end": 210.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 209.12,
    "end": 212.64,
    "text": "học sinh tiểu học được giới thiệu với",
    "textdich": ""
  },
  {
    "start": 210.71,
    "end": 212.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 210.72,
    "end": 215.64,
    "text": "những khái niệm mà trước đó chỉ xuất",
    "textdich": ""
  },
  {
    "start": 212.63,
    "end": 215.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 212.64,
    "end": 218.879,
    "text": "hiện ở bậc đại học. Lý thuyết tập hợp.",
    "textdich": ""
  },
  {
    "start": 215.63,
    "end": 218.879,
    "text": "",
    "textdich": ""
  },
  {
    "start": 215.64,
    "end": 221.08,
    "text": "Các hệ đếm với cơ số khác 10. Ví dụ đếm",
    "textdich": ""
  },
  {
    "start": 218.869,
    "end": 221.08,
    "text": "",
    "textdich": ""
  },
  {
    "start": 218.879,
    "end": 223.4,
    "text": "theo cơ số 2 hoặc cơ  số 8 thay",
    "textdich": ""
  },
  {
    "start": 221.07,
    "end": 223.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 221.08,
    "end": 226.48,
    "text": "vì cơ số 10 quen thuộc và logic hình",
    "textdich": ""
  },
  {
    "start": 223.39,
    "end": 226.48,
    "text": "",
    "textdich": ""
  },
  {
    "start": 223.4,
    "end": 228.76,
    "text": "thức. Nghe có vẻ xa lạ nhưng logic đằng",
    "textdich": ""
  },
  {
    "start": 226.47,
    "end": 228.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 226.48,
    "end": 231.2,
    "text": "sau nó khá rõ ràng. Những người thiết kế",
    "textdich": ""
  },
  {
    "start": 228.75,
    "end": 231.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 228.76,
    "end": 233.76,
    "text": "chương trình tin rằng nếu học sinh hiểu",
    "textdich": ""
  },
  {
    "start": 231.19,
    "end": 233.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 231.2,
    "end": 236.2,
    "text": "được cấu trúc nền tảng của toán học, tức",
    "textdich": ""
  },
  {
    "start": 233.75,
    "end": 236.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 233.76,
    "end": 238.4,
    "text": "là hiểu vì sao các quy tắc số học hoạt",
    "textdich": ""
  },
  {
    "start": 236.19,
    "end": 238.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 236.2,
    "end": 240.84,
    "text": "động, thì các em sẽ không cần học thuộc",
    "textdich": ""
  },
  {
    "start": 238.39,
    "end": 240.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 238.4,
    "end": 244.159,
    "text": "lòng hàng loạt công thức nữa. Các em sẽ",
    "textdich": ""
  },
  {
    "start": 240.83,
    "end": 244.159,
    "text": "",
    "textdich": ""
  },
  {
    "start": 240.84,
    "end": 245.879,
    "text": "tự suy luận ra được. Nói cách khác, mục",
    "textdich": ""
  },
  {
    "start": 244.149,
    "end": 245.879,
    "text": "",
    "textdich": ""
  },
  {
    "start": 244.159,
    "end": 248.56,
    "text": "tiêu không phải là dạy học sinh tính",
    "textdich": ""
  },
  {
    "start": 245.869,
    "end": 248.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 245.879,
    "end": 250.599,
    "text": "nhanh,  tính đúng. Mục tiêu là",
    "textdich": ""
  },
  {
    "start": 248.55,
    "end": 250.599,
    "text": "",
    "textdich": ""
  },
  {
    "start": 248.56,
    "end": 253.239,
    "text": "dạy các em tư duy như một nhà toán học",
    "textdich": ""
  },
  {
    "start": 250.589,
    "end": 253.239,
    "text": "",
    "textdich": ""
  },
  {
    "start": 250.599,
    "end": 256.107,
    "text": "thực thụ, đặt câu hỏi về bản chất của",
    "textdich": ""
  },
  {
    "start": 253.229,
    "end": 256.107,
    "text": "",
    "textdich": ""
  },
  {
    "start": 253.239,
    "end": 257.56,
    "text": "con số thay vì chỉ thao tác với chúng.",
    "textdich": ""
  },
  {
    "start": 256.097,
    "end": 257.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 256.107,
    "end": 260.12,
    "text": " Đây chính là điểm khác biệt",
    "textdich": ""
  },
  {
    "start": 257.55,
    "end": 260.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 257.56,
    "end": 262.16,
    "text": "cốt lõi so với cách chúng ta học toán ở",
    "textdich": ""
  },
  {
    "start": 260.11,
    "end": 262.16,
    "text": "",
    "textdich": ""
  },
  {
    "start": 260.12,
    "end": 264.52,
    "text": "trường phổ thông ngày nay.",
    "textdich": ""
  },
  {
    "start": 262.15,
    "end": 264.52,
    "text": "",
    "textdich": ""
  },
  {
    "start": 262.16,
    "end": 266.587,
    "text": "Một bên hỏi tại sao điều này đúng, một",
    "textdich": ""
  },
  {
    "start": 264.51,
    "end": 266.587,
    "text": "",
    "textdich": ""
  },
  {
    "start": 264.52,
    "end": 267.8,
    "text": "bên hỏi làm sao ra được đáp số này.",
    "textdich": ""
  },
  {
    "start": 266.577,
    "end": 267.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 266.587,
    "end": 269.52,
    "text": "",
    "textdich": ""
  },
  {
    "start": 267.79,
    "end": 269.52,
    "text": "",
    "textdich": ""
  },
  {
    "start": 267.8,
    "end": 271.639,
    "text": "Trên lý thuyết, đây là một tầm nhìn đầy",
    "textdich": ""
  },
  {
    "start": 269.51,
    "end": 271.639,
    "text": "",
    "textdich": ""
  },
  {
    "start": 269.52,
    "end": 274.32,
    "text": "tham vọng. Nhưng khi đưa vào hàng chục",
    "textdich": ""
  },
  {
    "start": 271.629,
    "end": 274.32,
    "text": "",
    "textdich": ""
  },
  {
    "start": 271.639,
    "end": 278.479,
    "text": "nghìn lớp học thực tế trên khắp nước Mỹ,",
    "textdich": ""
  },
  {
    "start": 274.31,
    "end": 278.479,
    "text": "",
    "textdich": ""
  },
  {
    "start": 274.32,
    "end": 278.479,
    "text": "mọi thứ bắt đầu đi trạch hướng.",
    "textdich": ""
  },
  {
    "start": 279.99,
    "end": 279.99,
    "text": "",
    "textdich": ""
  },
  {
    "start": 280.0,
    "end": 283.84,
    "text": "Vấn đề  đầu tiên và cũng là",
    "textdich": ""
  },
  {
    "start": 281.71,
    "end": 283.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 281.72,
    "end": 286.919,
    "text": "nghiêm trọng nhất, nằm ở chính những",
    "textdich": ""
  },
  {
    "start": 283.83,
    "end": 286.919,
    "text": "",
    "textdich": ""
  },
  {
    "start": 283.84,
    "end": 288.96,
    "text": "người đứng lớp. Để dạy New Math, giáo",
    "textdich": ""
  },
  {
    "start": 286.909,
    "end": 288.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 286.919,
    "end": 291.52,
    "text": "viên không chỉ cần biết công thức, họ",
    "textdich": ""
  },
  {
    "start": 288.95,
    "end": 291.52,
    "text": "",
    "textdich": ""
  },
  {
    "start": 288.96,
    "end": 293.44,
    "text": "cần thực sự hiểu bản chất logic đằng sau",
    "textdich": ""
  },
  {
    "start": 291.51,
    "end": 293.44,
    "text": "",
    "textdich": ""
  },
  {
    "start": 291.52,
    "end": 295.479,
    "text": "lý thuyết tập hợp, đằng sau các hệ đếm",
    "textdich": ""
  },
  {
    "start": 293.43,
    "end": 295.479,
    "text": "",
    "textdich": ""
  },
  {
    "start": 293.44,
    "end": 297.32,
    "text": "khác cơ số 10. ",
    "textdich": ""
  },
  {
    "start": 295.469,
    "end": 297.32,
    "text": "",
    "textdich": ""
  },
  {
    "start": 295.479,
    "end": 298.88,
    "text": "Nhưng phần lớn giáo viên tiểu học lúc đó",
    "textdich": ""
  },
  {
    "start": 297.31,
    "end": 298.88,
    "text": "",
    "textdich": ""
  },
  {
    "start": 297.32,
    "end": 300.8,
    "text": "chưa từng được đào tạo bài bản về những",
    "textdich": ""
  },
  {
    "start": 298.87,
    "end": 300.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 298.88,
    "end": 303.4,
    "text": "khái niệm này.  Bản thân họ",
    "textdich": ""
  },
  {
    "start": 300.79,
    "end": 303.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 300.8,
    "end": 306.0,
    "text": "cũng học toán theo lối cũ. Kết quả là",
    "textdich": ""
  },
  {
    "start": 303.39,
    "end": 306.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 303.4,
    "end": 307.919,
    "text": "gì? Nhiều giáo viên đứng trước lớp cố",
    "textdich": ""
  },
  {
    "start": 305.99,
    "end": 307.919,
    "text": "",
    "textdich": ""
  },
  {
    "start": 306.0,
    "end": 310.32,
    "text": "gắng giảng một thứ mà chính mình cũng",
    "textdich": ""
  },
  {
    "start": 307.909,
    "end": 310.32,
    "text": "",
    "textdich": ""
  },
  {
    "start": 307.919,
    "end": 312.36,
    "text": "không nắm vững. Và khi giáo viên không",
    "textdich": ""
  },
  {
    "start": 310.31,
    "end": 312.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 310.32,
    "end": 314.68,
    "text": "hiểu thì bài giảng biến thành việc đọc",
    "textdich": ""
  },
  {
    "start": 312.35,
    "end": 314.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 312.36,
    "end": 317.039,
    "text": "thuộc lòng thuật ngữ mới, tập hợp, cấu",
    "textdich": ""
  },
  {
    "start": 314.67,
    "end": 317.039,
    "text": "",
    "textdich": ""
  },
  {
    "start": 314.68,
    "end": 319.56,
    "text": "trúc, cơ số mà không có sự thấu hiểu",
    "textdich": ""
  },
  {
    "start": 317.029,
    "end": 319.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 317.039,
    "end": 322.039,
    "text": "thật sự đằng  sau.",
    "textdich": ""
  },
  {
    "start": 319.55,
    "end": 322.039,
    "text": "",
    "textdich": ""
  },
  {
    "start": 319.56,
    "end": 325.24,
    "text": "Hậu quả tiếp theo, học sinh mang bài tập",
    "textdich": ""
  },
  {
    "start": 322.029,
    "end": 325.24,
    "text": "",
    "textdich": ""
  },
  {
    "start": 322.039,
    "end": 327.0,
    "text": "về nhà và phụ huynh, những người từng đi",
    "textdich": ""
  },
  {
    "start": 325.23,
    "end": 327.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 325.24,
    "end": 329.919,
    "text": "học theo lối truyền thống hoàn toàn",
    "textdich": ""
  },
  {
    "start": 326.99,
    "end": 329.919,
    "text": "",
    "textdich": ""
  },
  {
    "start": 327.0,
    "end": 331.433,
    "text": "không thể hiểu nổi con mình đang làm gì.",
    "textdich": ""
  },
  {
    "start": 329.909,
    "end": 331.433,
    "text": "",
    "textdich": ""
  },
  {
    "start": 329.919,
    "end": 332.08,
    "text": "Nhà toán học Kim Nhạc sĩ trào phúng",
    "textdich": ""
  },
  {
    "start": 331.423,
    "end": 332.08,
    "text": "",
    "textdich": ""
  },
  {
    "start": 331.433,
    "end": 336.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 332.07,
    "end": 336.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 332.08,
    "end": 337.96,
    "text": "Tom Lar vào năm 1965 thậm chí đã sáng",
    "textdich": ""
  },
  {
    "start": 336.35,
    "end": 337.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 336.36,
    "end": 341.4,
    "text": "tác một bài hát châm  biếm mang",
    "textdich": ""
  },
  {
    "start": 337.95,
    "end": 341.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 337.96,
    "end": 344.759,
    "text": "tên New Math chế giễu chính cái ngôn ngữ",
    "textdich": ""
  },
  {
    "start": 341.39,
    "end": 344.759,
    "text": "",
    "textdich": ""
  },
  {
    "start": 341.4,
    "end": 346.16,
    "text": "tối nghĩa mà chương trình này tạo ra.",
    "textdich": ""
  },
  {
    "start": 344.749,
    "end": 346.16,
    "text": "",
    "textdich": ""
  },
  {
    "start": 344.759,
    "end": 348.039,
    "text": "Bài hát trở  thành hiện tượng",
    "textdich": ""
  },
  {
    "start": 346.15,
    "end": 348.039,
    "text": "",
    "textdich": ""
  },
  {
    "start": 346.16,
    "end": 351.479,
    "text": "vì nó nói trúng nỗi bức xúc của hàng",
    "textdich": ""
  },
  {
    "start": 348.029,
    "end": 351.479,
    "text": "",
    "textdich": ""
  },
  {
    "start": 348.039,
    "end": 354.16,
    "text": "triệu phụ huynh Mỹ lúc bấy giờ.",
    "textdich": ""
