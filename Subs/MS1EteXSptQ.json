[
  {
    "start": 1.964,
    "end": 3.984,
    "text": "",
    "textdich": ""
  },
  {
    "start": 5.19,
    "end": 5.19,
    "text": "",
    "textdich": ""
  },
  {
    "start": 5.2,
    "end": 9.519,
    "text": "Trong thế giới ồn ào và mệt mỏi này có",
    "textdich": ""
  },
  {
    "start": 7.789,
    "end": 9.519,
    "text": "",
    "textdich": ""
  },
  {
    "start": 7.799,
    "end": 11.48,
    "text": "một  bí mật đang bị giấu kín",
    "textdich": ""
  },
  {
    "start": 9.509,
    "end": 11.48,
    "text": "",
    "textdich": ""
  },
  {
    "start": 9.519,
    "end": 13.759,
    "text": "ngay trong chính hơi thở của mình. Một",
    "textdich": ""
  },
  {
    "start": 11.47,
    "end": 13.759,
    "text": "",
    "textdich": ""
  },
  {
    "start": 11.48,
    "end": 15.32,
    "text": "phương pháp đơn giản đến ngỡ ngàng nhưng",
    "textdich": ""
  },
  {
    "start": 13.749,
    "end": 15.32,
    "text": "",
    "textdich": ""
  },
  {
    "start": 13.759,
    "end": 18.0,
    "text": "lại có sức mạnh thay đổi toàn ",
    "textdich": ""
  },
  {
    "start": 15.31,
    "end": 18.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 15.32,
    "end": 20.199,
    "text": "bộ sinh lực, giấc ngủ và sự minh mẫn mỗi",
    "textdich": ""
  },
  {
    "start": 17.99,
    "end": 20.199,
    "text": "",
    "textdich": ""
  },
  {
    "start": 18.0,
    "end": 22.72,
    "text": "ngày. Đó chính là hơi thở tụ khí đan",
    "textdich": ""
  },
  {
    "start": 20.189,
    "end": 22.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 20.199,
    "end": 24.235,
    "text": "điền tại giường. Bí kíp mà 100% người",
    "textdich": ""
  },
  {
    "start": 22.71,
    "end": 24.235,
    "text": "",
    "textdich": ""
  },
  {
    "start": 22.72,
    "end": 25.72,
    "text": "tập luyện đều đạt được. Chỉ cần",
    "textdich": ""
  },
  {
    "start": 24.225,
    "end": 25.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 24.235,
    "end": 27.84,
    "text": " biết cách, chúng ta đang sống",
    "textdich": ""
  },
  {
    "start": 25.71,
    "end": 27.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 25.72,
    "end": 30.4,
    "text": "trong thời đại tràn ngập thông tin, kỹ",
    "textdich": ""
  },
  {
    "start": 27.83,
    "end": 30.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 27.84,
    "end": 31.84,
    "text": "thuật và phương pháp cải thiện sức khỏe.",
    "textdich": ""
  },
  {
    "start": 30.39,
    "end": 31.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 30.4,
    "end": 34.6,
    "text": "Nhưng đôi khi  chính những",
    "textdich": ""
  },
  {
    "start": 31.83,
    "end": 34.6,
    "text": "",
    "textdich": ""
  },
  {
    "start": 31.84,
    "end": 37.399,
    "text": "phương pháp quá dễ, quá đơn giản lại bị",
    "textdich": ""
  },
  {
    "start": 34.59,
    "end": 37.399,
    "text": "",
    "textdich": ""
  },
  {
    "start": 34.6,
    "end": 40.0,
    "text": "phớt lờ, bị đánh giá thấp hoặc hoàn toàn",
    "textdich": ""
  },
  {
    "start": 37.389,
    "end": 40.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 37.399,
    "end": 41.68,
    "text": "bị lãng quên. Một trong những bí mật quý",
    "textdich": ""
  },
  {
    "start": 39.99,
    "end": 41.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 40.0,
    "end": 44.48,
    "text": "giá nhất của hệ thống dưỡng sinh phương",
    "textdich": ""
  },
  {
    "start": 41.67,
    "end": 44.48,
    "text": "",
    "textdich": ""
  },
  {
    "start": 41.68,
    "end": 45.559,
    "text": "Đông chính là hơi thở tụ khí đan điền.",
    "textdich": ""
  },
  {
    "start": 44.47,
    "end": 45.559,
    "text": "",
    "textdich": ""
  },
  {
    "start": 44.48,
    "end": 47.84,
    "text": "Đặc  biệt khi thực hành trên",
    "textdich": ""
  },
  {
    "start": 45.549,
    "end": 47.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 45.559,
    "end": 49.32,
    "text": "giường, nó trở thành cánh cửa tĩnh lặng",
    "textdich": ""
  },
  {
    "start": 47.83,
    "end": 49.32,
    "text": "",
    "textdich": ""
  },
  {
    "start": 47.84,
    "end": 51.32,
    "text": "nhưng mạnh mẽ để bước  vào",
    "textdich": ""
  },
  {
    "start": 49.31,
    "end": 51.32,
    "text": "",
    "textdich": ""
  },
  {
    "start": 49.32,
    "end": 54.76,
    "text": "trạng thái tái tạo sâu sắc của thân tâm",
    "textdich": ""
  },
  {
    "start": 51.31,
    "end": 54.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 51.32,
    "end": 57.64,
    "text": "khí. Để hiểu rõ trước hết cần biết đan",
    "textdich": ""
  },
  {
    "start": 54.75,
    "end": 57.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 54.76,
    "end": 59.199,
    "text": "điền là gì, trong đông y và các hệ",
    "textdich": ""
  },
  {
    "start": 57.63,
    "end": 59.199,
    "text": "",
    "textdich": ""
  },
  {
    "start": 57.64,
    "end": 61.6,
    "text": " thống luyện khí cổ chuyển như",
    "textdich": ""
  },
  {
    "start": 59.189,
    "end": 61.6,
    "text": "",
    "textdich": ""
  },
  {
    "start": 59.199,
    "end": 63.535,
    "text": "đạo gia, dịch cân kinh, nội đan, đan",
    "textdich": ""
  },
  {
    "start": 61.59,
    "end": 63.535,
    "text": "",
    "textdich": ""
  },
  {
    "start": 61.6,
    "end": 65.199,
    "text": "điền hạ được coi là trung tâm lưu trữ",
    "textdich": ""
  },
  {
    "start": 63.525,
    "end": 65.199,
    "text": "",
    "textdich": ""
  },
  {
    "start": 63.535,
    "end": 67.68,
    "text": " và phân phối khí, năng lượng",
    "textdich": ""
  },
  {
    "start": 65.189,
    "end": 67.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 65.199,
    "end": 70.92,
    "text": "sống của cơ thể. Vị trí tương đương vùng",
    "textdich": ""
  },
  {
    "start": 67.67,
    "end": 70.92,
    "text": "",
    "textdich": ""
  },
  {
    "start": 67.68,
    "end": 73.2,
    "text": "bụng dưới cách rốn khoảng 2 đến 3 cm và",
    "textdich": ""
  },
  {
    "start": 70.91,
    "end": 73.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 70.92,
    "end": 75.4,
    "text": "sâu vào bên trong, nơi tập trung tủy,",
    "textdich": ""
  },
  {
    "start": 73.19,
    "end": 75.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 73.2,
    "end": 77.56,
    "text": "huyết,  thần và khí. Người xưa",
    "textdich": ""
  },
  {
    "start": 75.39,
    "end": 77.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 75.4,
    "end": 79.68,
    "text": "gọi đó là nơi thần ngự, khí sinh mệnh",
    "textdich": ""
  },
  {
    "start": 77.55,
    "end": 79.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 77.56,
    "end": 81.84,
    "text": "tụ. Khí theo nghĩa phương Đông không chỉ",
    "textdich": ""
  },
  {
    "start": 79.67,
    "end": 81.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 79.68,
    "end": 83.88,
    "text": "là không khí hay  hơi thở mà là",
    "textdich": ""
  },
  {
    "start": 81.83,
    "end": 83.88,
    "text": "",
    "textdich": ""
  },
  {
    "start": 81.84,
    "end": 85.799,
    "text": "dòng năng lượng sống bao trùm vận hành",
    "textdich": ""
  },
  {
    "start": 83.87,
    "end": 85.799,
    "text": "",
    "textdich": ""
  },
  {
    "start": 83.88,
    "end": 88.64,
    "text": "toàn bộ sinh lý và  tinh thần",
    "textdich": ""
  },
  {
    "start": 85.789,
    "end": 88.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 85.799,
    "end": 91.52,
    "text": "con người. Khi khí đầy người khỏe mạnh,",
    "textdich": ""
  },
  {
    "start": 88.63,
    "end": 91.52,
    "text": "",
    "textdich": ""
  },
  {
    "start": 88.64,
    "end": 93.72,
    "text": "sáng suốt, nhẹ nhàng, dẻo dai. Khi khí",
    "textdich": ""
  },
  {
    "start": 91.51,
    "end": 93.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 91.52,
    "end": 96.72,
    "text": "yếu, cơ thể sinh bệnh,  tâm trí",
    "textdich": ""
  },
  {
    "start": 93.71,
    "end": 96.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 93.72,
    "end": 99.119,
    "text": "mệt mỏi, tinh thần phân tán. Do đó, kỹ",
    "textdich": ""
  },
  {
    "start": 96.71,
    "end": 99.119,
    "text": "",
    "textdich": ""
  },
  {
    "start": 96.72,
    "end": 101.72,
    "text": "thuật tụ khí về đan điền không chỉ để",
    "textdich": ""
  },
  {
    "start": 99.109,
    "end": 101.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 99.119,
    "end": 104.36,
    "text": "thở dễ chịu mà là quá trình phục hồi,",
    "textdich": ""
  },
  {
    "start": 101.71,
    "end": 104.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 101.72,
    "end": 107.0,
    "text": "tích trữ và ổn định cội nguồn sinh lực.",
    "textdich": ""
  },
  {
    "start": 104.35,
    "end": 107.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 104.36,
    "end": 109.0,
    "text": "Vì sao thực hành tại giường lại hiệu quả",
    "textdich": ""
  },
  {
    "start": 106.99,
    "end": 109.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 107.0,
    "end": 110.96,
    "text": "khi nằm trên giường, đặc biệt trước khi",
    "textdich": ""
  },
  {
    "start": 108.99,
    "end": 110.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 109.0,
    "end": 113.719,
    "text": "ngủ,  lúc tâm trí láng dịu,",
    "textdich": ""
  },
  {
    "start": 110.95,
    "end": 113.719,
    "text": "",
    "textdich": ""
  },
  {
    "start": 110.96,
    "end": 115.32,
    "text": "buông bỏ lo toan hoặc vừa thức dậy. Khi",
    "textdich": ""
  },
  {
    "start": 113.709,
    "end": 115.32,
    "text": "",
    "textdich": ""
  },
  {
    "start": 113.719,
    "end": 116.96,
    "text": "hệ thần kinh chưa bị kích thích bởi",
    "textdich": ""
  },
  {
    "start": 115.31,
    "end": 116.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 115.32,
    "end": 119.28,
    "text": "ngoại cảnh,  thân thể rơi vào",
    "textdich": ""
  },
  {
    "start": 116.95,
    "end": 119.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 116.96,
    "end": 121.799,
    "text": "trạng thái mềm mại, tiếp đất hoàn toàn",
    "textdich": ""
  },
  {
    "start": 119.27,
    "end": 121.799,
    "text": "",
    "textdich": ""
  },
  {
    "start": 119.28,
    "end": 124.24,
    "text": "trên nệm. Hệ hô hấp trở về quỹ đạo sinh",
    "textdich": ""
  },
  {
    "start": 121.789,
    "end": 124.24,
    "text": "",
    "textdich": ""
  },
  {
    "start": 121.799,
    "end": 126.92,
    "text": "học ban đầu, bụng dưới không bị ép bởi",
    "textdich": ""
  },
  {
    "start": 124.23,
    "end": 126.92,
    "text": "",
    "textdich": ""
  },
  {
    "start": 124.24,
    "end": 129.28,
    "text": "cột sống hay cơ bụng vận động, tâm trí",
    "textdich": ""
  },
  {
    "start": 126.91,
    "end": 129.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 126.92,
    "end": 131.319,
    "text": "mở ra nhận thức sâu hơn. Toàn bộ hệ",
    "textdich": ""
  },
  {
    "start": 129.27,
    "end": 131.319,
    "text": "",
    "textdich": ""
  },
  {
    "start": 129.28,
    "end": 133.36,
    "text": "thống sinh học và tinh thần lúc này sẵn",
    "textdich": ""
  },
  {
    "start": 131.309,
    "end": 133.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 131.319,
    "end": 135.2,
    "text": "sàng đón khí tụ về mà không gặp kháng",
    "textdich": ""
  },
  {
    "start": 133.35,
    "end": 135.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 133.36,
    "end": 137.48,
    "text": "trợ.  Không cần tư thế thẳng,",
    "textdich": ""
  },
  {
    "start": 135.19,
    "end": 137.48,
    "text": "",
    "textdich": ""
  },
  {
    "start": 135.2,
    "end": 140.76,
    "text": "không cần cố gắng kiểm soát, chỉ cần thở",
    "textdich": ""
  },
  {
    "start": 137.47,
    "end": 140.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 137.48,
    "end": 143.04,
    "text": "đúng khí sẽ tự tụ. Điều kỳ diệu là 100%",
    "textdich": ""
  },
  {
    "start": 140.75,
    "end": 143.04,
    "text": "",
    "textdich": ""
  },
  {
    "start": 140.76,
    "end": 145.239,
    "text": "người có thể tập được. Dù cao tuổi, bệnh",
    "textdich": ""
  },
  {
    "start": 143.03,
    "end": 145.239,
    "text": "",
    "textdich": ""
  },
  {
    "start": 143.04,
    "end": 147.519,
    "text": "mãn tính, bận rộn hay chưa từng thiền",
    "textdich": ""
  },
  {
    "start": 145.229,
    "end": 147.519,
    "text": "",
    "textdich": ""
  },
  {
    "start": 145.239,
    "end": 149.879,
    "text": "khí công, chỉ cần chiếc giường êm ái,",
    "textdich": ""
  },
  {
    "start": 147.509,
    "end": 149.879,
    "text": "",
    "textdich": ""
  },
  {
    "start": 147.519,
    "end": 152.0,
    "text": "tâm trí lắng xuống và chút hướng dẫn đơn",
    "textdich": ""
  },
  {
    "start": 149.869,
    "end": 152.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 149.879,
    "end": 154.08,
    "text": "giản. Chính sự bình dân này khiến nhiều",
    "textdich": ""
  },
  {
    "start": 151.99,
    "end": 154.08,
    "text": "",
    "textdich": ""
  },
  {
    "start": 152.0,
    "end": 156.28,
    "text": "người nghi ngờ, nghĩ điều đơn giản không",
    "textdich": ""
  },
  {
    "start": 154.07,
    "end": 156.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 154.08,
    "end": 157.856,
    "text": "thể tạo biến chuyển lớn. Nhưng sự thật",
    "textdich": ""
  },
  {
    "start": 156.27,
    "end": 157.856,
    "text": "",
    "textdich": ""
  },
  {
    "start": 156.28,
    "end": 159.92,
    "text": "khi thực hành đều đặn, nó chuyển",
    "textdich": ""
  },
  {
    "start": 157.846,
    "end": 159.92,
    "text": "",
    "textdich": ""
  },
  {
    "start": 157.856,
    "end": 162.0,
    "text": " hóa tận gốc. Cơ chế hiệu quả",
    "textdich": ""
  },
  {
    "start": 159.91,
    "end": 162.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 159.92,
    "end": 163.959,
    "text": "bao gồm ba tác động song song, sinh lý",
    "textdich": ""
  },
  {
    "start": 161.99,
    "end": 163.959,
    "text": "",
    "textdich": ""
  },
  {
    "start": 162.0,
    "end": 165.68,
    "text": "học, thở chậm sâu, kích thích hệ phó",
    "textdich": ""
  },
  {
    "start": 163.949,
    "end": 165.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 163.959,
    "end": 167.76,
    "text": "giao cảm, phục hồi tái  tạo,",
    "textdich": ""
  },
  {
    "start": 165.67,
    "end": 167.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 165.68,
    "end": 170.8,
    "text": "xoa bóp nội tạng, ổn định tim mạch và",
    "textdich": ""
  },
  {
    "start": 167.75,
    "end": 170.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 167.76,
    "end": 173.319,
    "text": "miễn dịch. Tinh thần, ý niệm, dẫn khí",
    "textdich": ""
  },
  {
    "start": 170.79,
    "end": 173.319,
    "text": "",
    "textdich": ""
  },
  {
    "start": 170.8,
    "end": 176.2,
    "text": "giúp tâm trí quy nhất xuất hiện ấm nóng,",
    "textdich": ""
  },
  {
    "start": 173.309,
    "end": 176.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 173.319,
    "end": 178.76,
    "text": "tê nhẹ tại đan điền. Năng lượng theo nội",
    "textdich": ""
  },
  {
    "start": 176.19,
    "end": 178.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 176.2,
    "end": 180.879,
    "text": "đan, khí tụ nuôi dưỡng nguyên khí, tái",
    "textdich": ""
  },
  {
    "start": 178.75,
    "end": 180.879,
    "text": "",
    "textdich": ""
  },
  {
    "start": 178.76,
    "end": 183.12,
    "text": "tạo  tủy não, huyết và thần",
    "textdich": ""
  },
  {
    "start": 180.869,
    "end": 183.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 180.879,
    "end": 185.0,
    "text": "chữa lành từ bên trong. Nhiều người bỏ",
    "textdich": ""
  },
  {
    "start": 183.11,
    "end": 185.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 183.12,
    "end": 186.92,
    "text": "qua vì những gì dễ làm,  thường",
    "textdich": ""
  },
  {
    "start": 184.99,
    "end": 186.92,
    "text": "",
    "textdich": ""
  },
  {
    "start": 185.0,
    "end": 189.0,
    "text": "bị trì hoãn, chạy theo phương pháp cao",
    "textdich": ""
  },
  {
    "start": 186.91,
    "end": 189.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 186.92,
    "end": 190.68,
    "text": "siêu khắc nghiệt mà quên chiếc giường và",
    "textdich": ""
  },
  {
    "start": 188.99,
    "end": 190.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 189.0,
    "end": 192.84,
    "text": "hơi thở  là công cụ mạnh mẽ",
    "textdich": ""
  },
  {
    "start": 190.67,
    "end": 192.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 190.68,
    "end": 195.319,
    "text": "nhất. Kỹ thuật này còn bị coi là huyền",
    "textdich": ""
  },
  {
    "start": 192.83,
    "end": 195.319,
    "text": "",
    "textdich": ""
  },
  {
    "start": 192.84,
    "end": 197.159,
    "text": "bí, khó hiểu. Thực tế  nó khác",
    "textdich": ""
  },
  {
    "start": 195.309,
    "end": 197.159,
    "text": "",
    "textdich": ""
  },
  {
    "start": 195.319,
    "end": 199.28,
    "text": "thiền hay khí công cổ điển ở cách tiếp",
    "textdich": ""
  },
  {
    "start": 197.149,
    "end": 199.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 197.159,
    "end": 201.4,
    "text": "cận, không cần ngồi thẳng, động tác phức",
    "textdich": ""
  },
  {
    "start": 199.27,
    "end": 201.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 199.28,
    "end": 203.28,
    "text": "tạp, chỉ là lúi tắt hiệu quả với hơi",
    "textdich": ""
  },
  {
    "start": 201.39,
    "end": 203.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 201.4,
    "end": 206.0,
    "text": "thở,  cảm nhận và sự đồng thuận",
    "textdich": ""
  },
  {
    "start": 203.27,
    "end": 206.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 203.28,
    "end": 207.48,
    "text": "tâm trí, bài học vỡ lòng cho người mới.",
    "textdich": ""
  },
  {
    "start": 205.99,
    "end": 207.48,
    "text": "",
    "textdich": ""
  },
  {
    "start": 206.0,
    "end": 209.92,
    "text": "Những người thực hành đều đặn thường",
    "textdich": ""
  },
  {
    "start": 207.47,
    "end": 209.92,
    "text": "",
    "textdich": ""
  },
  {
    "start": 207.48,
    "end": 211.799,
    "text": "chuyển hóa rõ rệt. Người mất ngủ ngủ sâu",
    "textdich": ""
  },
  {
    "start": 209.91,
    "end": 211.799,
    "text": "",
    "textdich": ""
  },
  {
    "start": 209.92,
    "end": 213.84,
    "text": "sau ba  tuần, người lo âu giảm",
    "textdich": ""
  },
  {
    "start": 211.789,
    "end": 213.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 211.799,
    "end": 216.04,
    "text": "căng thẳng sau vài ngày. Người phục hồi",
    "textdich": ""
  },
  {
    "start": 213.83,
    "end": 216.04,
    "text": "",
    "textdich": ""
  },
  {
    "start": 213.84,
    "end": 217.84,
    "text": "đột quỵ tỉnh táo hơn. Không ai nghĩ nằm",
    "textdich": ""
  },
  {
    "start": 216.03,
    "end": 217.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 216.04,
    "end": 219.76,
    "text": "thở lại hiệu quả đến vậy.  Hãy",
    "textdich": ""
  },
  {
    "start": 217.83,
    "end": 219.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 217.84,
    "end": 222.12,
    "text": "để các cô bác, anh chị trải nghiệm chính",
    "textdich": ""
  },
  {
    "start": 219.75,
    "end": 222.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 219.76,
    "end": 224.159,
    "text": "mình. Không ai thở hay tụ khí thay mình",
    "textdich": ""
  },
  {
    "start": 222.11,
    "end": 224.159,
    "text": "",
    "textdich": ""
  },
  {
    "start": 222.12,
    "end": 226.959,
    "text": "được. Chỉ cần dừng lại, nằm ",
    "textdich": ""
  },
  {
    "start": 224.149,
    "end": 226.959,
    "text": "",
    "textdich": ""
  },
  {
    "start": 224.159,
    "end": 229.68,
    "text": "xuống, thở đúng và cảm nhận sâu. Tối",
    "textdich": ""
  },
  {
    "start": 226.949,
    "end": 229.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 226.959,
    "end": 232.28,
    "text": "nay, tắt đèn, nằm yên, đặt hai tay lên",
    "textdich": ""
  },
  {
    "start": 229.67,
    "end": 232.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 229.68,
    "end": 235.2,
    "text": "bụng dưới, nhắm mắt, hít sâu chậm, để",
    "textdich": ""
  },
  {
    "start": 232.27,
    "end": 235.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 232.28,
    "end": 238.239,
    "text": "bụng phồng, thở ra để bụng xẹp. Giữ tâm",
    "textdich": ""
  },
  {
    "start": 235.19,
    "end": 238.239,
    "text": "",
    "textdich": ""
  },
  {
    "start": 235.2,
    "end": 241.28,
    "text": "trí tại đó 10 vòng, chúng ta sẽ cảm nhận",
    "textdich": ""
  },
  {
    "start": 238.229,
    "end": 241.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 238.239,
    "end": 244.28,
    "text": "điều gì đó đang dần xuất hiện. Đó là khí",
    "textdich": ""
  },
  {
    "start": 241.27,
    "end": 244.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 241.28,
    "end": 246.28,
    "text": "tụ nguồn sống trở về. Để tụ khí hiệu",
    "textdich": ""
  },
  {
    "start": 244.27,
    "end": 246.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 244.28,
    "end": 248.159,
    "text": "quả, chìa khóa nằm ở chuẩn bị tâm thân",
    "textdich": ""
  },
  {
    "start": 246.27,
    "end": 248.159,
    "text": "",
    "textdich": ""
  },
  {
    "start": 246.28,
    "end": 250.36,
    "text": "trước khi thực hành. Nếu chưa chạm đúng",
    "textdich": ""
  },
  {
    "start": 248.149,
    "end": 250.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 248.159,
    "end": 252.56,
    "text": "trạng thái, khí không tụ được. Thời điểm",
    "textdich": ""
  },
  {
    "start": 250.35,
    "end": 252.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 250.36,
    "end": 254.36,
    "text": "vàng là trước ngủ hoặc vừa tỉnh dậy. Khi",
    "textdich": ""
  },
  {
    "start": 252.55,
    "end": 254.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 252.56,
    "end": 256.56,
    "text": "thân tâm sẵn sàng, thân thể ",
    "textdich": ""
  },
  {
    "start": 254.35,
    "end": 256.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 254.36,
    "end": 259.04,
    "text": "phải trống, buông lỏng hoàn toàn bằng",
    "textdich": ""
  },
  {
    "start": 256.55,
    "end": 259.04,
    "text": "",
    "textdich": ""
  },
  {
    "start": 256.56,
    "end": 261.079,
    "text": "cách nằm ngửa, thả lỏng từng phần từ",
    "textdich": ""
  },
  {
    "start": 259.03,
    "end": 261.079,
    "text": "",
    "textdich": ""
  },
  {
    "start": 259.04,
    "end": 263.56,
    "text": "chân lên đầu.  Tâm trí phải",
    "textdich": ""
  },
  {
    "start": 261.069,
    "end": 263.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 261.079,
    "end": 265.88,
    "text": "rỗng dịch chuyển chú ý về đan điền,",
    "textdich": ""
  },
  {
    "start": 263.55,
    "end": 265.88,
    "text": "",
    "textdich": ""
  },
  {
    "start": 263.56,
    "end": 266.56,
    "text": "không xua đuổi suy nghĩ mà nhẹ nhàng đưa",
    "textdich": ""
  },
  {
    "start": 265.87,
    "end": 266.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 265.88,
    "end": 268.8,
    "text": "về. ",
    "textdich": ""
  },
  {
    "start": 266.55,
    "end": 268.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 266.56,
    "end": 270.8,
    "text": "Trạng thái đúng là chậm lại, lòng mềm",
    "textdich": ""
  },
  {
    "start": 268.79,
    "end": 270.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 268.8,
    "end": 273.199,
    "text": "tĩnh lặng bên trong, tránh mang điện",
    "textdich": ""
  },
  {
    "start": 270.79,
    "end": 273.199,
    "text": "",
    "textdich": ""
  },
  {
    "start": 270.8,
    "end": 275.44,
    "text": "thoại nằm sai tư thế nóng vội hoặc ép",
    "textdich": ""
  },
  {
    "start": 273.189,
    "end": 275.44,
    "text": "",
    "textdich": ""
  },
  {
    "start": 273.199,
    "end": 278.08,
    "text": "buộc. Kỹ thuật cốt lõi là phương pháp ba",
    "textdich": ""
  },
  {
    "start": 275.43,
    "end": 278.08,
    "text": "",
    "textdich": ""
  },
  {
    "start": 275.44,
    "end": 280.84,
    "text": "lớp khí. Trước tiên nằm ngửa thân tâm đã",
    "textdich": ""
  },
  {
    "start": 278.07,
    "end": 280.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 278.08,
    "end": 283.72,
    "text": "chuẩn bị, đặt tay nhẹ lên bụng dưới lớp",
    "textdich": ""
  },
  {
    "start": 280.83,
    "end": 283.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 280.84,
    "end": 285.88,
    "text": "sơ tầng. Hít nhẹ ba giây, để bụng phồng",
    "textdich": ""
  },
  {
    "start": 283.71,
    "end": 285.88,
    "text": "",
    "textdich": ""
  },
  {
    "start": 283.72,
    "end": 288.12,
    "text": "thở ra 6 giây để xẹt.  Tập",
    "textdich": ""
  },
  {
    "start": 285.87,
    "end": 288.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 285.88,
    "end": 290.6,
    "text": "trung chuyển động bụng 5 đến 10 vòng.",
    "textdich": ""
  },
  {
    "start": 288.11,
    "end": 290.6,
    "text": "",
    "textdich": ""
  },
  {
    "start": 288.12,
    "end": 292.28,
    "text": "Lớp trung tầng hít sâu hơn 4 giây, hình",
    "textdich": ""
  },
  {
    "start": 290.59,
    "end": 292.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 290.6,
    "end": 295.16,
    "text": "dung khí trượt xuống đan điền ",
    "textdich": ""
  },
  {
    "start": 292.27,
    "end": 295.16,
    "text": "",
    "textdich": ""
  },
  {
    "start": 292.28,
    "end": 298.028,
    "text": "thở ra 7 giây. Giữ tâm tại đó 10 vòng",
    "textdich": ""
  },
  {
    "start": 295.15,
    "end": 298.028,
    "text": "",
    "textdich": ""
  },
  {
    "start": 295.16,
    "end": 299.96,
    "text": "cảm nhận ấm t. Lớp cao tầng hít",
    "textdich": ""
  },
  {
    "start": 298.018,
    "end": 299.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 298.028,
    "end": 302.613,
    "text": " 5 đến 6 giây dẫn khí tụ thành",
    "textdich": ""
  },
  {
    "start": 299.95,
    "end": 302.613,
    "text": "",
    "textdich": ""
  },
  {
    "start": 299.96,
    "end": 304.56,
    "text": "viên cầu. Thở ra 8 đến 10 giây thầm",
    "textdich": ""
  },
  {
    "start": 302.603,
    "end": 304.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 302.613,
    "end": 307.96,
    "text": " khí quy đan điền năm vòng rồi",
    "textdich": ""
  },
  {
    "start": 304.55,
    "end": 307.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 304.56,
    "end": 310.473,
    "text": "nằm yên. Đón nhận ấm đẩy tê thông khí mà",
    "textdich": ""
  },
  {
    "start": 307.95,
    "end": 310.473,
    "text": "",
    "textdich": ""
  },
  {
    "start": 307.96,
    "end": 312.88,
    "text": "không can thiệp. Tránh nén ép so đo",
    "textdich": ""
  },
  {
    "start": 310.463,
    "end": 312.88,
    "text": "",
    "textdich": ""
  },
  {
    "start": 310.473,
    "end": 315.72,
    "text": " vội tầng luyện khi no hoặc lo",
    "textdich": ""
  },
  {
    "start": 312.87,
    "end": 315.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 312.88,
    "end": 317.678,
    "text": "lắng. Nếu rối quay về chuẩn bị. Sau",
    "textdich": ""
  },
  {
    "start": 315.71,
    "end": 317.678,
    "text": "",
    "textdich": ""
  },
  {
    "start": 315.72,
    "end": 319.4,
    "text": "luyện nằm yên hai đến 3 phút giữ khí",
    "textdich": ""
  },
  {
    "start": 317.668,
    "end": 319.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 317.678,
    "end": 321.96,
    "text": " không tan, thầm biết khí đang",
    "textdich": ""
  },
  {
    "start": 319.39,
    "end": 321.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 319.4,
    "end": 324.228,
    "text": "ở lại, hít sâu, thở ra mãn nguyện cảm ơn",
    "textdich": ""
  },
  {
    "start": 321.95,
    "end": 324.228,
    "text": "",
    "textdich": ""
  },
  {
    "start": 321.96,
    "end": 326.199,
    "text": "thân thể. Sau bảy ngày đều đặn, tín hiệu",
    "textdich": ""
  },
  {
    "start": 324.218,
    "end": 326.199,
    "text": "",
    "textdich": ""
  },
  {
    "start": 324.228,
    "end": 328.56,
    "text": " xuất hiện, bụng dưới ấm đầy,",
    "textdich": ""
  },
  {
    "start": 326.189,
    "end": 328.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 326.199,
    "end": 331.16,
    "text": "ngủ sâu, tỉnh táo sinh lực, thân nhẹ tâm",
    "textdich": ""
  },
  {
    "start": 328.55,
    "end": 331.16,
    "text": "",
    "textdich": ""
  },
  {
    "start": 328.56,
    "end": 332.84,
