    "start": 558.75,
    "end": 562.48,
    "text": "",
    "textdich": ""
  },
  {
    "start": 558.76,
    "end": 565.76,
    "text": "là mình an toàn. Đấy, ý là như vậy. Cho",
    "textdich": ""
  },
  {
    "start": 562.47,
    "end": 565.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 562.48,
    "end": 568.32,
    "text": "nên là bảo là vì uống độ đen và giảm béo",
    "textdich": ""
  },
  {
