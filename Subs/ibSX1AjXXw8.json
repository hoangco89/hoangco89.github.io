  },
  {
    "start": 460.95,
    "end": 462.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 460.96,
    "end": 465.8,
    "text": "gian dài không ạ?",
    "textdich": ""
  },
  {
    "start": 461.99,
    "end": 465.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 462.0,
    "end": 468.039,
    "text": "À nói về cái chỗ này thì có lẽ Quỳnh Anh",
    "textdich": ""
  },
  {
    "start": 465.79,
    "end": 468.039,
    "text": "",
    "textdich": ""
  },
  {
    "start": 465.8,
    "end": 468.44,
    "text": "phải cho mình phát biểu sang một cái ý",
    "textdich": ""
  },
  {
    "start": 468.029,
    "end": 468.44,
    "text": "",
    "textdich": ""
  },
  {
    "start": 468.039,
    "end": 473.72,
    "text": "này.",
    "textdich": ""
  },
  {
    "start": 468.43,
    "end": 473.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 468.44,
    "end": 479.159,
    "text": "Dạ. Tức là vấn đề ăn đạm, ăn thịt và vấn",
