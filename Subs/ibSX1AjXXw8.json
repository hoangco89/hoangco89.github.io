    "start": 545.79,
    "end": 548.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 545.8,
    "end": 549.399,
    "text": "phải nó tiêu mỡ.",
    "textdich": ""
  },
  {
    "start": 548.11,
    "end": 549.399,
    "text": "",
    "textdich": ""
  },
  {
    "start": 548.12,
    "end": 550.8,
    "text": "Bạn bạn Quỳnh Anh ạ.",
    "textdich": ""
  },
  {
    "start": 549.389,
    "end": 550.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 549.399,
    "end": 554.12,
    "text": "Dạ.",
    "textdich": ""
  },
  {
    "start": 550.79,
    "end": 554.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 550.8,
    "end": 556.519,
    "text": "Uống đỗ đen ăn đỗ đen thì đỗ đen không",
    "textdich": ""
  },
  {
    "start": 554.11,
    "end": 556.519,
    "text": "",
    "textdich": ""
  },
  {
    "start": 554.12,
    "end": 558.76,
    "text": "tiêu mỡ. Nhưng mà uống đỗ đen ăn đỗ đen",
    "textdich": ""
  },
  {
    "start": 556.509,
    "end": 558.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 556.519,
    "end": 562.48,
    "text": "thì nó không cung cấp lượng mỡ cho nên",
    "textdich": ""
  },
