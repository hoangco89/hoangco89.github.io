[
  {
    "start": 0.28,
    "end": 3.56,
    "text": "Dạ vâng ạ. Xin được cảm ơn những chia sẻ",
    "textdich": ""
  },
  {
    "start": 1.589,
    "end": 3.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 1.599,
    "end": 5.4,
    "text": "của bác sĩ. Vâng thưa quý vị và theo y",
    "textdich": ""
  },
  {
    "start": 3.55,
    "end": 5.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 3.56,
    "end": 7.24,
    "text": "học cổ truyền thì đậu đen có vị ngọt",
    "textdich": ""
  },
  {
    "start": 5.39,
    "end": 7.24,
    "text": "",
    "textdich": ""
  },
  {
    "start": 5.4,
    "end": 9.24,
    "text": "này, tính bình và tác dụng là thanh",
    "textdich": ""
  },
  {
    "start": 7.23,
    "end": 9.24,
    "text": "",
    "textdich": ""
  },
  {
    "start": 7.24,
    "end": 11.12,
    "text": "nhiệt giải độc cơ thể, hỗ trợ lưu thông",
    "textdich": ""
  },
  {
    "start": 9.23,
    "end": 11.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 9.24,
    "end": 13.36,
    "text": "khí huyết và lợi thủy cũng như là kiện",
    "textdich": ""
  },
  {
    "start": 11.11,
    "end": 13.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 11.12,
    "end": 15.72,
    "text": "tỳ. Đặc biệt là loại hạt này được đông y",
    "textdich": ""
  },
  {
    "start": 13.35,
    "end": 15.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 13.36,
    "end": 17.56,
    "text": "đã quy thuộc thành thủy và có liên quan",
    "textdich": ""
  },
  {
    "start": 15.71,
    "end": 17.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 15.72,
    "end": 19.32,
    "text": " mật thiết đến tạng thận. Vì",
    "textdich": ""
  },
  {
    "start": 17.55,
    "end": 19.32,
    "text": "",
    "textdich": ""
  },
  {
    "start": 17.56,
    "end": 21.279,
    "text": "thế mà chúng được sử dụng để có thể chữa",
    "textdich": ""
  },
  {
    "start": 19.31,
    "end": 21.279,
    "text": "",
    "textdich": ""
  },
  {
    "start": 19.32,
    "end": 22.96,
    "text": "thận yếu, tăng cường chức năng cho thận.",
    "textdich": ""
  },
  {
    "start": 21.269,
    "end": 22.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 21.279,
    "end": 24.64,
    "text": "Và chữa thận yếu bằng đỗ đen chính là",
    "textdich": ""
  },
  {
    "start": 22.95,
    "end": 24.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 22.96,
    "end": 26.519,
    "text": "phương pháp đã được lưu truyền khá rộng",
    "textdich": ""
  },
  {
    "start": 24.63,
    "end": 26.519,
    "text": "",
    "textdich": ""
  },
  {
    "start": 24.64,
    "end": 28.599,
    "text": "rãi trong dân gian. Tuy nhiên thì không",
    "textdich": ""
  },
  {
    "start": 26.509,
    "end": 28.599,
    "text": "",
    "textdich": ""
  },
  {
    "start": 26.519,
    "end": 30.92,
    "text": "phải ai cũng biết cách dùng. Và dưới đây",
    "textdich": ""
  },
  {
    "start": 28.589,
    "end": 30.92,
    "text": "",
    "textdich": ""
  },
  {
    "start": 28.599,
    "end": 32.68,
    "text": "chính là cách một số những gợi ý về bác",
    "textdich": ""
  },
  {
    "start": 30.91,
    "end": 32.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 30.92,
    "end": 35.68,
    "text": "các bài thuốc chữa thận yếu bằng đậu",
    "textdich": ""
  },
  {
    "start": 32.67,
    "end": 35.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 32.68,
    "end": 35.68,
    "text": "đen.",
    "textdich": ""
  },
  {
    "start": 39.91,
    "end": 39.91,
    "text": "",
    "textdich": ""
  },
  {
    "start": 39.92,
    "end": 43.84,
    "text": "Các bài thuốc hỗ trợ điều trị thận yếu",
    "textdich": ""
  },
  {
    "start": 41.59,
    "end": 43.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 41.6,
    "end": 47.399,
    "text": "từ đỗ đen.",
    "textdich": ""
  },
  {
    "start": 43.83,
    "end": 47.399,
    "text": "",
    "textdich": ""
  },
  {
    "start": 43.84,
    "end": 49.52,
    "text": "Đỗ đen kết hợp với cây cỏ chanh.",
    "textdich": ""
  },
  {
    "start": 47.389,
    "end": 49.52,
    "text": "",
    "textdich": ""
  },
  {
    "start": 47.399,
    "end": 51.8,
    "text": "Theo đông y, cỏ chanh có vị ngọt, tính",
    "textdich": ""
  },
  {
    "start": 49.51,
    "end": 51.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 49.52,
    "end": 53.92,
    "text": "hàn tác dụng thanh nhiệt, giải khát. Khi",
    "textdich": ""
  },
  {
    "start": 51.79,
    "end": 53.92,
    "text": "",
    "textdich": ""
  },
  {
    "start": 51.8,
    "end": 56.28,
    "text": "kết hợp cỏ chanh với đỗ đen giúp tiêu ứ,",
    "textdich": ""
  },
  {
    "start": 53.91,
    "end": 56.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 53.92,
    "end": 58.199,
    "text": "lợi huyết, lợi tiểu, bổ thận. Đặc biệt",
    "textdich": ""
  },
  {
    "start": 56.27,
    "end": 58.199,
    "text": "",
    "textdich": ""
  },
  {
    "start": 56.28,
    "end": 60.6,
    "text": "hỗ trợ giảm trứng chảy máu cam, tiểu da",
    "textdich": ""
  },
  {
    "start": 58.189,
    "end": 60.6,
    "text": "",
    "textdich": ""
  },
  {
    "start": 58.199,
    "end": 63.96,
    "text": "máu, tiểu xón, tiểu bí. Chuẩn bị nguyên",
    "textdich": ""
  },
  {
    "start": 60.59,
    "end": 63.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 60.6,
    "end": 66.119,
    "text": "liệu: 100 g đậu đen tươi, 15 g cỏ chanh,",
    "textdich": ""
  },
  {
    "start": 63.95,
    "end": 66.119,
    "text": "",
    "textdich": ""
  },
  {
    "start": 63.96,
    "end": 68.159,
    "text": "1 L nước lọc.",
    "textdich": ""
  },
  {
    "start": 66.109,
    "end": 68.159,
    "text": "",
    "textdich": ""
  },
  {
    "start": 66.119,
    "end": 70.479,
    "text": "Thực hiện bài thuốc. Đậu đen nhặt sạch",
    "textdich": ""
  },
  {
    "start": 68.149,
    "end": 70.479,
    "text": "",
    "textdich": ""
  },
  {
    "start": 68.159,
    "end": 72.799,
    "text": "loại bỏ hạt hỏng sâu. Cỏ chanh loại bỏ",
    "textdich": ""
  },
  {
    "start": 70.469,
    "end": 72.799,
    "text": "",
    "textdich": ""
  },
  {
    "start": 70.479,
    "end": 74.799,
    "text": "lá vàng úa giữ lại phần cỏ tươi. Rửa",
    "textdich": ""
  },
  {
    "start": 72.789,
    "end": 74.799,
    "text": "",
    "textdich": ""
  },
  {
    "start": 72.799,
    "end": 76.64,
    "text": "sạch tất cả các nguyên liệu rồi để ráo.",
    "textdich": ""
  },
  {
    "start": 74.789,
    "end": 76.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 74.799,
    "end": 78.64,
    "text": "Cho độ đèn và cỏ chanh vào bình. Đun",
    "textdich": ""
  },
  {
    "start": 76.63,
    "end": 78.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 76.64,
    "end": 83.36,
    "text": "cùng 1 lí nước trong khoảng 10 phút, lọc",
    "textdich": ""
  },
  {
    "start": 78.63,
    "end": 83.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 78.64,
    "end": 83.36,
    "text": "lấy phần nước, bỏ bã uống trong ngày.",
    "textdich": ""
  },
  {
    "start": 86.83,
    "end": 86.83,
    "text": "",
    "textdich": ""
  },
  {
    "start": 86.84,
    "end": 91.96,
    "text": "Đậu đen kết hợp với cây nhọ nồi. Nhọ nồi",
    "textdich": ""
  },
  {
    "start": 90.03,
    "end": 91.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 90.04,
    "end": 93.84,
    "text": "hay còn được gọi là cây cỏ mực, hạ liên",
    "textdich": ""
  },
  {
    "start": 91.95,
    "end": 93.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 91.96,
    "end": 95.799,
    "text": "thảo. Đây là vị thuốc được biết đến với",
    "textdich": ""
  },
  {
    "start": 93.83,
    "end": 95.799,
    "text": "",
    "textdich": ""
  },
  {
    "start": 93.84,
    "end": 97.96,
    "text": "công dụng phổ biến nhất là cầm máu, bổ",
    "textdich": ""
  },
  {
    "start": 95.789,
    "end": 97.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 95.799,
    "end": 100.0,
    "text": "thận âm, làm đen tóc. Bài thuốc từ đỗ",
    "textdich": ""
  },
  {
    "start": 97.95,
    "end": 100.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 97.96,
    "end": 101.759,
    "text": "đen và cây nhọ nồi rất dễ thực hiện. Lại",
    "textdich": ""
  },
  {
    "start": 99.99,
    "end": 101.759,
    "text": "",
    "textdich": ""
  },
  {
    "start": 100.0,
    "end": 103.439,
    "text": "phát huy tối đa công dụng giúp tăng",
    "textdich": ""
  },
  {
    "start": 101.749,
    "end": 103.439,
    "text": "",
    "textdich": ""
  },
  {
    "start": 101.759,
    "end": 107.759,
    "text": "cường chức năng thận. Chuẩn bị nguyên",
    "textdich": ""
  },
  {
    "start": 103.429,
    "end": 107.759,
    "text": "",
    "textdich": ""
  },
  {
    "start": 103.439,
    "end": 109.6,
    "text": "liệu: Đậu đen tươi 40 g, nhọ nồi 30 g.",
    "textdich": ""
  },
  {
    "start": 107.749,
    "end": 109.6,
    "text": "",
    "textdich": ""
  },
  {
    "start": 107.759,
    "end": 111.719,
    "text": "Cách thực hiện: Đậu đen nhọ nồi nhặt",
    "textdich": ""
  },
  {
    "start": 109.59,
    "end": 111.719,
    "text": "",
    "textdich": ""
  },
  {
    "start": 109.6,
    "end": 113.88,
    "text": "sạch sẽ phần sâu hỏng rồi rửa sạch. Đỗ",
    "textdich": ""
  },
  {
    "start": 111.709,
    "end": 113.88,
    "text": "",
    "textdich": ""
  },
  {
    "start": 111.719,
    "end": 116.32,
    "text": "đen rang cho đến khi có mùi thơm. Cho đỗ",
    "textdich": ""
  },
  {
    "start": 113.87,
    "end": 116.32,
    "text": "",
    "textdich": ""
  },
  {
    "start": 113.88,
    "end": 118.2,
    "text": "rang và nhọn nồi vào bình sắc kỹ. Lưu ý",
    "textdich": ""
  },
  {
    "start": 116.31,
    "end": 118.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 116.32,
    "end": 120.399,
    "text": "sau khi nước sôi thì vặn nhỏ lửa luôn",
    "textdich": ""
  },
  {
    "start": 118.19,
    "end": 120.399,
    "text": "",
    "textdich": ""
  },
  {
    "start": 118.2,
    "end": 122.079,
    "text": "khoảng 30 phút rồi tắt bếp. Uống khi",
    "textdich": ""
  },
  {
    "start": 120.389,
    "end": 122.079,
    "text": "",
    "textdich": ""
  },
  {
    "start": 120.399,
    "end": 124.32,
    "text": "nước đậu đen vào nhọ nổi còn ấm để có",
    "textdich": ""
  },
  {
    "start": 122.069,
    "end": 124.32,
    "text": "",
    "textdich": ""
  },
  {
    "start": 122.079,
    "end": 127.759,
    "text": "kết quả tốt nhất. Sử dụng liên tục từ 2",
    "textdich": ""
  },
  {
    "start": 124.31,
    "end": 127.759,
    "text": "",
    "textdich": ""
  },
  {
    "start": 124.32,
    "end": 127.759,
    "text": "đến 3 tháng.",
    "textdich": ""
  },
  {
    "start": 128.949,
    "end": 128.949,
    "text": "",
    "textdich": ""
  },
  {
    "start": 128.959,
    "end": 134.04,
    "text": "Đậu đen kết hợp vừng đen. Vừng đen, mè",
    "textdich": ""
  },
  {
    "start": 132.03,
    "end": 134.04,
    "text": "",
    "textdich": ""
  },
  {
    "start": 132.04,
    "end": 136.2,
    "text": "đen và đậu đen là những loại hạt được",
    "textdich": ""
  },
  {
    "start": 134.03,
    "end": 136.2,
    "text": "",
    "textdich": ""
  },
  {
    "start": 134.04,
    "end": 138.4,
    "text": "dùng làm nguyên liệu nấu xôi, nấu chè.",
    "textdich": ""
  },
  {
    "start": 136.19,
    "end": 138.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 136.2,
    "end": 140.04,
    "text": "Bên cạnh đó, vừng đen, đậu đen cũng có",
    "textdich": ""
  },
  {
    "start": 138.39,
    "end": 140.04,
    "text": "",
    "textdich": ""
  },
  {
    "start": 138.4,
    "end": 141.879,
    "text": "thể kết hợp với nhau thành bài thuốc bổ",
    "textdich": ""
  },
  {
    "start": 140.03,
    "end": 141.879,
    "text": "",
    "textdich": ""
  },
  {
    "start": 140.04,
    "end": 143.8,
    "text": "thận giúp giảm tổn thương và phục hồi",
    "textdich": ""
  },
  {
    "start": 141.869,
    "end": 143.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 141.879,
    "end": 146.68,
    "text": "chức năng thận. Chuẩn bị nguyên liệu:",
    "textdich": ""
  },
  {
    "start": 143.79,
    "end": 146.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 143.8,
    "end": 149.0,
    "text": "Đậu đen 100 g, vừng đen 30 g. Cách thực",
    "textdich": ""
  },
  {
    "start": 146.67,
    "end": 149.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 146.68,
    "end": 150.84,
    "text": "hiện: Đậu đen và vừng đen răng thơm. Tái",
    "textdich": ""
  },
  {
    "start": 148.99,
    "end": 150.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 149.0,
    "end": 152.92,
    "text": "nhuyễn cả hai nguyên liệu thành bột mịn.",
    "textdich": ""
  },
  {
    "start": 150.83,
    "end": 152.92,
    "text": "",
    "textdich": ""
  },
  {
    "start": 150.84,
    "end": 156.879,
    "text": "Lấy hai thìa bột pha cùng nước ấm. Uống",
    "textdich": ""
  },
  {
    "start": 152.91,
    "end": 156.879,
    "text": "",
    "textdich": ""
  },
  {
    "start": 152.92,
    "end": 156.879,
    "text": "trước khi ăn 30 phút.",
    "textdich": ""
  },
  {
    "start": 157.589,
    "end": 157.589,
    "text": "",
    "textdich": ""
  },
  {
    "start": 157.599,
    "end": 161.0,
    "text": "Đậu đen thì còn chữa cũng như là giúp",
    "textdich": ""
  },
  {
    "start": 159.47,
    "end": 161.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 159.48,
    "end": 162.84,
    "text": "chúng ta hỗ trợ điều trị trong việc là",
    "textdich": ""
  },
  {
    "start": 160.99,
    "end": 162.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 161.0,
    "end": 164.72,
    "text": "thanh nhiệt này hay là các cái chứng như",
    "textdich": ""
  },
  {
    "start": 162.83,
    "end": 164.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 162.84,
    "end": 166.08,
    "text": "là thận hư và thận hiếu. Thì bác sĩ có",
    "textdich": ""
  },
  {
    "start": 164.71,
    "end": 166.08,
    "text": "",
    "textdich": ""
  },
  {
    "start": 164.72,
    "end": 167.4,
    "text": "thể chia sẻ thêm về những cái công dụng",
    "textdich": ""
  },
  {
    "start": 166.07,
    "end": 167.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 166.08,
    "end": 171.76,
    "text": "này được không ạ?",
    "textdich": ""
  },
  {
    "start": 167.39,
    "end": 171.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 167.4,
    "end": 175.0,
    "text": "Thế nói đậu đen thì là các cụ thấy rằng",
    "textdich": ""
  },
  {
    "start": 171.75,
    "end": 175.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 171.76,
    "end": 178.159,
    "text": "là nó có cái tác dụng là nó vào thận bởi",
    "textdich": ""
  },
  {
    "start": 174.99,
    "end": 178.159,
    "text": "",
    "textdich": ""
  },
  {
    "start": 175.0,
    "end": 180.0,
    "text": "vì thế này màu đen mà.",
    "textdich": ""
  },
  {
    "start": 178.149,
    "end": 180.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 178.159,
    "end": 184.08,
    "text": "Mấy cái nhận xét như thế này, tính vị",
    "textdich": ""
  },
  {
    "start": 179.99,
    "end": 184.08,
    "text": "",
    "textdich": ""
  },
  {
    "start": 180.0,
    "end": 188.0,
    "text": "quy kinh của thuốc ấy thì một là vị vị",
    "textdich": ""
  },
  {
    "start": 184.07,
    "end": 188.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 184.08,
    "end": 190.799,
    "text": "thí dụ như vị mặn thì là vào thận. Thế",
    "textdich": ""
  },
  {
    "start": 187.99,
    "end": 190.799,
    "text": "",
    "textdich": ""
  },
  {
    "start": 188.0,
    "end": 194.0,
    "text": "màu thì màu đen thì vào thận. Thế là đậu",
    "textdich": ""
  },
  {
    "start": 190.789,
    "end": 194.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 190.799,
    "end": 197.519,
    "text": "đen này là màu đen cho nên là nó vào",
    "textdich": ""
  },
  {
    "start": 193.99,
    "end": 197.519,
    "text": "",
    "textdich": ""
  },
  {
    "start": 194.0,
    "end": 199.959,
    "text": "thận. Thế vào thận thì tác động là các",
    "textdich": ""
  },
  {
    "start": 197.509,
    "end": 199.959,
    "text": "",
    "textdich": ""
  },
  {
    "start": 197.519,
    "end": 201.72,
    "text": "cụ suy luận thôi chứ còn bây giờ cũng",
    "textdich": ""
  },
  {
    "start": 199.949,
    "end": 201.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 199.959,
    "end": 204.319,
    "text": "chưa có công trình nào nghiên cứu bảo",
    "textdich": ""
  },
  {
    "start": 201.71,
    "end": 204.319,
    "text": "",
    "textdich": ""
  },
  {
    "start": 201.72,
    "end": 207.4,
    "text": "rằng là nó vào như thế nào rồi nó bổ như",
    "textdich": ""
  },
  {
    "start": 204.309,
    "end": 207.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 204.319,
    "end": 210.439,
    "text": "thế nào tạo ra chất gì cho thận thì chưa",
    "textdich": ""
  },
  {
    "start": 207.39,
    "end": 210.439,
    "text": "",
    "textdich": ""
  },
  {
    "start": 207.4,
    "end": 214.519,
    "text": "có. Thế nhưng mà rõ ràng là về mặt lý",
    "textdich": ""
  },
  {
    "start": 210.429,
    "end": 214.519,
    "text": "",
    "textdich": ""
  },
  {
    "start": 210.439,
    "end": 217.64,
    "text": "luận ấy thì cứ màu xanh là vào can, vị",
    "textdich": ""
  },
  {
    "start": 214.509,
    "end": 217.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 214.519,
    "end": 221.0,
    "text": "chua là vào can. Thế mặn thì là vào",
    "textdich": ""
  },
  {
    "start": 217.63,
    "end": 221.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 217.64,
    "end": 223.48,
    "text": "thận, đen thì vào thận. Thí dụ như thế.",
    "textdich": ""
  },
  {
    "start": 220.99,
    "end": 223.48,
    "text": "",
    "textdich": ""
  },
  {
    "start": 221.0,
    "end": 227.76,
    "text": "Thế cho nên là bây giờ thí dụ như là",
    "textdich": ""
  },
  {
    "start": 223.47,
    "end": 227.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 223.48,
    "end": 230.0,
    "text": "trong cái vị mà bổ thận nổi tiếng là cái",
    "textdich": ""
  },
  {
    "start": 227.75,
    "end": 230.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 227.76,
    "end": 233.76,
    "text": "thục địa chẳng hạn thì người ta phải tạo",
    "textdich": ""
  },
  {
    "start": 229.99,
    "end": 233.76,
    "text": "",
    "textdich": ""
  },
  {
    "start": 230.0,
    "end": 235.64,
    "text": "cái sinh địa thành cái thục. Mà thục nó",
    "textdich": ""
  },
  {
    "start": 233.75,
    "end": 235.64,
    "text": "",
    "textdich": ""
  },
  {
    "start": 233.76,
    "end": 238.519,
    "text": "có màu đen như thế thì nó vào thận rất",
    "textdich": ""
  },
  {
    "start": 235.63,
    "end": 238.519,
    "text": "",
    "textdich": ""
  },
  {
    "start": 235.64,
    "end": 242.68,
    "text": "là tốt và nó bổ thận rất là tốt. Thì đậu",
    "textdich": ""
  },
  {
    "start": 238.509,
    "end": 242.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 238.519,
    "end": 244.799,
    "text": "đen cũng như vậy. Thế bổ thận thì nó có",
    "textdich": ""
  },
  {
    "start": 242.67,
    "end": 244.799,
    "text": "",
    "textdich": ""
  },
  {
    "start": 242.68,
    "end": 247.159,
    "text": "lại từ cái chức năng của thận chúng ta",
    "textdich": ""
  },
  {
    "start": 244.789,
    "end": 247.159,
    "text": "",
    "textdich": ""
  },
  {
    "start": 244.799,
    "end": 249.56,
    "text": "suy ra các cái tác dụng như thế này. Tức",
    "textdich": ""
  },
  {
    "start": 247.149,
    "end": 249.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 247.159,
    "end": 251.799,
    "text": "là thí dụ thận chủ cốt chẳng hạn. Thế",
    "textdich": ""
  },
  {
    "start": 249.55,
    "end": 251.799,
    "text": "",
    "textdich": ""
  },
  {
    "start": 249.56,
    "end": 254.319,
    "text": "thì đau lưng, đau xương là cái thận này",
    "textdich": ""
  },
  {
    "start": 251.789,
    "end": 254.319,
    "text": "",
    "textdich": ""
  },
  {
    "start": 251.799,
    "end": 256.359,
    "text": "nó sẽ hỗ trợ.",
    "textdich": ""
  },
  {
    "start": 254.309,
    "end": 256.359,
    "text": "",
    "textdich": ""
  },
  {
    "start": 254.319,
    "end": 259.32,
    "text": "Thế cái thì thận sinh tinh tinh sinh",
    "textdich": ""
  },
  {
    "start": 256.349,
    "end": 259.32,
    "text": "",
    "textdich": ""
  },
  {
    "start": 256.359,
    "end": 261.44,
    "text": "tủy, tủy sinh huyết như vậy là nó bổ",
    "textdich": ""
  },
  {
    "start": 259.31,
    "end": 261.44,
    "text": "",
    "textdich": ""
  },
  {
    "start": 259.32,
    "end": 264.44,
    "text": "thận có nghĩa là nó hỗ trợ cho cái việc",
    "textdich": ""
  },
  {
    "start": 261.43,
    "end": 264.44,
    "text": "",
    "textdich": ""
  },
  {
    "start": 261.44,
    "end": 267.0,
    "text": "sinh huyết. Đấy. Thế thì thận sinh tinh",
    "textdich": ""
  },
  {
    "start": 264.43,
    "end": 267.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 264.44,
    "end": 271.479,
    "text": "chẳng hạn thì nó bổ thận tức là hỗ trợ",
    "textdich": ""
  },
  {
    "start": 266.99,
    "end": 271.479,
    "text": "",
    "textdich": ""
  },
  {
    "start": 267.0,
    "end": 274.639,
    "text": "cho cái việc là ừ cái tình cảm nam nữ",
    "textdich": ""
  },
  {
    "start": 271.469,
    "end": 274.639,
    "text": "",
    "textdich": ""
  },
  {
    "start": 271.479,
    "end": 276.44,
    "text": "vân vân và vân vân. Đấy vân vân.",
    "textdich": ""
  },
  {
    "start": 274.629,
    "end": 276.44,
    "text": "",
    "textdich": ""
  },
  {
    "start": 274.639,
    "end": 277.8,
    "text": "Dạ vâng ạ. À vâng thưa bác sĩ thì có lẽ",
    "textdich": ""
  },
  {
    "start": 276.43,
    "end": 277.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 276.44,
    "end": 279.56,
    "text": "là đây là một cái thông tin mà nhiều chị",
    "textdich": ""
  },
  {
    "start": 277.79,
    "end": 279.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 277.8,
    "end": 281.8,
    "text": "em hiện nay cũng đang áp dụng đấy là",
    "textdich": ""
  },
  {
    "start": 279.55,
    "end": 281.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 279.56,
    "end": 284.12,
    "text": "uống nước đỗ đen rang và v với hy vọng",
    "textdich": ""
  },
  {
    "start": 281.79,
    "end": 284.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 281.8,
    "end": 286.28,
    "text": "là sẽ giảm được cân. Vậy thì điều này có",
    "textdich": ""
  },
  {
    "start": 284.11,
    "end": 286.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 284.12,
    "end": 287.72,
    "text": "thực sự đúng hay không? Và nếu như mà",
    "textdich": ""
  },
  {
    "start": 286.27,
    "end": 287.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 286.28,
    "end": 289.039,
    "text": "chúng ta uống nước đậu đen rang thì sẽ",
    "textdich": ""
  },
  {
    "start": 287.71,
    "end": 289.039,
    "text": "",
    "textdich": ""
  },
  {
    "start": 287.72,
    "end": 290.96,
    "text": "có những cái tác dụng gì nữa Thưa bác",
    "textdich": ""
  },
  {
    "start": 289.029,
    "end": 290.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 289.039,
    "end": 294.4,
    "text": "sĩ,",
    "textdich": ""
  },
  {
    "start": 290.95,
    "end": 294.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 290.96,
    "end": 296.96,
    "text": "tôi cũng đi một số tỉnh thế thì vào rất",
    "textdich": ""
  },
  {
    "start": 294.39,
    "end": 296.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 294.4,
    "end": 299.28,
    "text": "nhiều nhà thì thấy là các ông ấy đọc các",
    "textdich": ""
  },
  {
    "start": 296.95,
    "end": 299.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 296.96,
    "end": 301.4,
    "text": "cái báo trong đó có cái báo cây thuốc",
    "textdich": ""
  },
  {
    "start": 299.27,
    "end": 301.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 299.28,
    "end": 304.919,
    "text": "quý chẳng hạn cũng giới thiệu về đậu",
    "textdich": ""
  },
  {
    "start": 301.39,
    "end": 304.919,
    "text": "",
    "textdich": ""
  },
  {
    "start": 301.4,
    "end": 307.0,
    "text": "đen. Thế thì có rất nhiều vị là rang đậu",
    "textdich": ""
  },
  {
    "start": 304.909,
    "end": 307.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 304.919,
    "end": 311.12,
    "text": "đen lên xong rồi cho vào cái chai và",
    "textdich": ""
  },
  {
    "start": 306.99,
    "end": 311.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 307.0,
    "end": 313.8,
    "text": "sáng này ra là lấy 99 hạt ăn xong rồi đi",
    "textdich": ""
  },
  {
    "start": 311.11,
    "end": 313.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 311.12,
    "end": 316.32,
    "text": "tập. Thế thì",
    "textdich": ""
  },
  {
    "start": 313.79,
    "end": 316.32,
    "text": "",
    "textdich": ""
  },
  {
    "start": 313.8,
    "end": 318.84,
    "text": "thế bảo thế tại sao lại làm thế này? bảo",
    "textdich": ""
  },
  {
    "start": 316.31,
    "end": 318.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 316.32,
    "end": 321.12,
    "text": "sách bảo rằng là cái này nó rất tốt cho",
    "textdich": ""
  },
  {
    "start": 318.83,
    "end": 321.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 318.84,
    "end": 323.52,
    "text": "cái thận. Bảo vâng thế thì bác cứ ăn",
    "textdich": ""
  },
  {
    "start": 321.11,
    "end": 323.52,
    "text": "",
    "textdich": ""
  },
  {
    "start": 321.12,
    "end": 327.36,
    "text": "cũng tốt. Thế có người thì lại không để",
    "textdich": ""
  },
  {
    "start": 323.51,
    "end": 327.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 323.52,
    "end": 331.199,
    "text": "nguyên hột rang như thế mà lại giã nó ra",
    "textdich": ""
  },
  {
    "start": 327.35,
    "end": 331.199,
    "text": "",
    "textdich": ""
  },
  {
    "start": 327.36,
    "end": 334.88,
    "text": "cơ. Giã nó nhỏ thành bột thế xong rồi",
    "textdich": ""
  },
  {
    "start": 331.189,
    "end": 334.88,
    "text": "",
    "textdich": ""
  },
  {
    "start": 331.199,
    "end": 337.199,
    "text": "quấy thành nước uống thế sáng này ra.",
    "textdich": ""
  },
  {
    "start": 334.87,
    "end": 337.199,
    "text": "",
    "textdich": ""
  },
  {
    "start": 334.88,
    "end": 340.479,
    "text": "Thế thì cũng là một cái tốt không có sao",
    "textdich": ""
  },
  {
    "start": 337.189,
    "end": 340.479,
    "text": "",
    "textdich": ""
  },
  {
    "start": 337.199,
    "end": 343.8,
    "text": "sất cả. Thế nhưng mà nên nhớ rằng đây nó",
    "textdich": ""
  },
  {
    "start": 340.469,
    "end": 343.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 340.479,
    "end": 346.16,
    "text": "chỉ là hỗ trợ chứ không phải nó điều trị",
    "textdich": ""
  },
  {
    "start": 343.79,
    "end": 346.16,
    "text": "",
    "textdich": ""
  },
  {
    "start": 343.8,
    "end": 349.199,
    "text": "một cái gì cả. Thí dụ bây giờ tôi bị",
    "textdich": ""
  },
  {
    "start": 346.15,
    "end": 349.199,
    "text": "",
    "textdich": ""
  },
  {
    "start": 346.16,
    "end": 353.24,
    "text": "bệnh gì đó mà bảo rằng là đây tôi có độ",
    "textdich": ""
  },
  {
    "start": 349.189,
    "end": 353.24,
    "text": "",
    "textdich": ""
  },
  {
    "start": 349.199,
    "end": 355.84,
    "text": "đen rồi thì cái đó là tốt nhưng mà không",
    "textdich": ""
  },
  {
    "start": 353.23,
    "end": 355.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 353.24,
    "end": 358.16,
    "text": "điều trị được cái gì sức cả mà nó là hỗ",
    "textdich": ""
  },
  {
    "start": 355.83,
    "end": 358.16,
    "text": "",
    "textdich": ""
  },
  {
    "start": 355.84,
    "end": 359.52,
    "text": "trợ cho các cái việc đấy đối với lại cái",
    "textdich": ""
  },
  {
    "start": 358.15,
    "end": 359.52,
    "text": "",
    "textdich": ""
  },
  {
    "start": 358.16,
    "end": 361.639,
    "text": "thận cũng vậy.",
    "textdich": ""
  },
  {
    "start": 359.51,
    "end": 361.639,
    "text": "",
    "textdich": ""
  },
  {
    "start": 359.52,
    "end": 363.96,
    "text": "Vâng. B sĩ có thể chia sẻ thêm về cái",
    "textdich": ""
  },
  {
    "start": 361.629,
    "end": 363.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 361.639,
    "end": 366.12,
    "text": "việc mà chúng ta rang đậu đen lên và",
    "textdich": ""
  },
  {
    "start": 363.95,
    "end": 366.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 363.96,
    "end": 367.319,
    "text": "chúng ta uống nước ấy ạ thì nó sẽ phát",
    "textdich": ""
  },
  {
    "start": 366.11,
    "end": 367.319,
    "text": "",
    "textdich": ""
  },
  {
    "start": 366.12,
    "end": 367.72,
    "text": "huy những cái công dụng nào được không",
    "textdich": ""
  },
  {
    "start": 367.309,
    "end": 367.72,
    "text": "",
    "textdich": ""
  },
  {
    "start": 367.319,
    "end": 370.16,
    "text": "ạ?",
    "textdich": ""
  },
  {
    "start": 367.71,
    "end": 370.16,
    "text": "",
    "textdich": ""
  },
  {
    "start": 367.72,
    "end": 373.599,
    "text": "Vâng. Ở trên tôi nói là bây giờ nói là",
    "textdich": ""
  },
  {
    "start": 370.15,
    "end": 373.599,
    "text": "",
    "textdich": ""
  },
  {
    "start": 370.16,
    "end": 375.639,
    "text": "công dụng gì thì chưa có nghiên cứu.",
    "textdich": ""
  },
  {
    "start": 373.589,
    "end": 375.639,
    "text": "",
    "textdich": ""
  },
  {
    "start": 373.599,
    "end": 379.28,
    "text": "Thế nhưng mà",
    "textdich": ""
  },
  {
    "start": 375.629,
    "end": 379.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 375.639,
    "end": 382.96,
    "text": "theo cái lý sự ấ thì đậu đen nó là tư âm",
    "textdich": ""
  },
  {
    "start": 379.27,
    "end": 382.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 379.28,
    "end": 386.12,
    "text": "nó vào thận. Thế thì nó tốt cho thận.",
    "textdich": ""
  },
  {
    "start": 382.95,
    "end": 386.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 382.96,
    "end": 389.96,
    "text": "Thế nhưng mà ở trong sách thì các cụ ghi",
    "textdich": ""
  },
  {
    "start": 386.11,
    "end": 389.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 386.12,
    "end": 393.88,
    "text": "là đậu đen thì là tính của nó mát và nó",
    "textdich": ""
  },
  {
    "start": 389.95,
    "end": 393.88,
    "text": "",
    "textdich": ""
  },
  {
    "start": 389.96,
    "end": 396.84,
    "text": "lại là vào phế và vị. Thế như vậy tức là",
    "textdich": ""
  },
  {
    "start": 393.87,
    "end": 396.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 393.88,
    "end": 400.08,
    "text": "nó để chữa giải cảm như trên và chữa các",
    "textdich": ""
  },
  {
    "start": 396.83,
    "end": 400.08,
    "text": "",
    "textdich": ""
  },
  {
    "start": 396.84,
    "end": 402.52,
    "text": "cái bệnh đường tiêu hóa. Nhưng mà nói là",
    "textdich": ""
  },
  {
    "start": 400.07,
    "end": 402.52,
    "text": "",
    "textdich": ""
  },
  {
    "start": 400.08,
    "end": 405.24,
    "text": "chữa thì phải phối hợp với các vị thuốc",
    "textdich": ""
  },
  {
    "start": 402.51,
    "end": 405.24,
    "text": "",
    "textdich": ""
  },
  {
    "start": 402.52,
    "end": 407.319,
    "text": "khác chứ không phải chỉ dùng độ đen để",
    "textdich": ""
  },
  {
    "start": 405.23,
    "end": 407.319,
    "text": "",
    "textdich": ""
  },
  {
    "start": 405.24,
    "end": 408.319,
    "text": "chữa. Nhưng mà thế này thì được này",
    "textdich": ""
  },
  {
    "start": 407.309,
    "end": 408.319,
    "text": "",
    "textdich": ""
  },
  {
    "start": 407.319,
    "end": 410.919,
    "text": "Quỳnh Anh này.",
    "textdich": ""
  },
  {
    "start": 408.309,
    "end": 410.919,
    "text": "",
    "textdich": ""
  },
  {
    "start": 408.319,
    "end": 413.479,
    "text": "Thí dụ như là hôm nay Quỳnh Anh đi suốt",
    "textdich": ""
  },
  {
    "start": 410.909,
    "end": 413.479,
    "text": "",
    "textdich": ""
  },
  {
    "start": 410.919,
    "end": 416.68,
    "text": "từ nhà đến đây nắng quá mùa hè tháng nă",
    "textdich": ""
  },
  {
    "start": 413.469,
    "end": 416.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 413.479,
    "end": 420.28,
    "text": "tháng s đấy nắng quá mồ hôi nhễ nhại.",
    "textdich": ""
  },
  {
    "start": 416.67,
    "end": 420.28,
    "text": "",
    "textdich": ""
  },
  {
    "start": 416.68,
    "end": 423.599,
    "text": "đến đây được chị Thu Hương chị ấy cho",
    "textdich": ""
  },
  {
    "start": 420.27,
    "end": 423.599,
    "text": "",
    "textdich": ""
  },
  {
    "start": 420.28,
    "end": 426.44,
    "text": "một bát chè độ đen mà lại thêm một tí đá",
    "textdich": ""
  },
  {
    "start": 423.589,
    "end": 426.44,
    "text": "",
    "textdich": ""
  },
  {
    "start": 423.599,
    "end": 429.52,
    "text": "nữa thì Quỳnh Anh tỉnh ra chứ còn gì",
    "textdich": ""
  },
  {
    "start": 426.43,
    "end": 429.52,
    "text": "",
    "textdich": ""
  },
  {
    "start": 426.44,
    "end": 431.36,
    "text": "nữa. Đấy thế thì là hoặc là đến đây lại",
    "textdich": ""
  },
  {
    "start": 429.51,
    "end": 431.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 429.52,
    "end": 433.36,
    "text": "cho bát chè độ đen.",
    "textdich": ""
  },
  {
    "start": 431.35,
    "end": 433.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 431.36,
    "end": 436.199,
    "text": "Thế bát chè độ đen nhiều khi ngày xưa",
    "textdich": ""
  },
  {
    "start": 433.35,
    "end": 436.199,
    "text": "",
    "textdich": ""
  },
  {
    "start": 433.36,
    "end": 438.24,
    "text": "người ta không có nhiều đường đâu thì",
    "textdich": ""
  },
  {
    "start": 436.189,
    "end": 438.24,
    "text": "",
    "textdich": ""
  },
  {
    "start": 436.199,
    "end": 440.319,
    "text": "người ta cho một tí muối thôi. Các cụ ở",
    "textdich": ""
  },
  {
    "start": 438.23,
    "end": 440.319,
    "text": "",
    "textdich": ""
  },
  {
    "start": 438.24,
    "end": 443.56,
    "text": "nhà quê cứ ăn với muối cũng được. Thế",
    "textdich": ""
  },
  {
    "start": 440.309,
    "end": 443.56,
    "text": "",
    "textdich": ""
  },
  {
    "start": 440.319,
    "end": 446.639,
    "text": "thì ăn xong là cảm thấy nó tỉnh táo và",
    "textdich": ""
  },
  {
    "start": 443.55,
    "end": 446.639,
    "text": "",
    "textdich": ""
  },
  {
    "start": 443.56,
    "end": 449.44,
    "text": "nó bớt mệt, bớt ra mồ hôi. Thế thì đấy",
    "textdich": ""
  },
  {
    "start": 446.629,
    "end": 449.44,
    "text": "",
    "textdich": ""
  },
  {
    "start": 446.639,
    "end": 450.479,
    "text": "nó là bổ là bổ như vậy và nó tốt là tốt",
    "textdich": ""
  },
  {
    "start": 449.43,
    "end": 450.479,
    "text": "",
    "textdich": ""
  },
  {
    "start": 449.44,
    "end": 451.879,
    "text": "như vậy.",
    "textdich": ""
  },
  {
    "start": 450.469,
    "end": 451.879,
    "text": "",
    "textdich": ""
  },
  {
    "start": 450.479,
    "end": 453.479,
    "text": "Và cũng có rất là nhiều chị em phụ nữ",
    "textdich": ""
  },
  {
    "start": 451.869,
    "end": 453.479,
    "text": "",
    "textdich": ""
  },
  {
    "start": 451.879,
    "end": 455.599,
    "text": "thì cũng rất là mong muốn là có thể giảm",
    "textdich": ""
  },
  {
    "start": 453.469,
    "end": 455.599,
    "text": "",
    "textdich": ""
  },
  {
    "start": 453.479,
    "end": 457.12,
    "text": "cân từ đậu đen. Vậy thì theo bác sĩ thì",
    "textdich": ""
  },
  {
    "start": 455.589,
    "end": 457.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 455.599,
    "end": 459.4,
    "text": "nó có cái tính liên hệ nào ở đây không?",
    "textdich": ""
  },
  {
    "start": 457.11,
    "end": 459.4,
    "text": "",
    "textdich": ""
  },
  {
    "start": 457.12,
    "end": 460.96,
    "text": "Và liệu rằng là chúng ta cũng nên sử",
    "textdich": ""
  },
  {
    "start": 459.39,
    "end": 460.96,
    "text": "",
    "textdich": ""
  },
  {
    "start": 459.4,
    "end": 462.0,
    "text": "dụng có nên sử dụng liên tục trong thời",
