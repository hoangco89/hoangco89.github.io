  },
  {
    "start": 538.15,
    "end": 540.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 538.16,
    "end": 543.6,
    "text": "nó không có cái hàm lượng cholesterol.",
    "textdich": ""
  },
  {
    "start": 540.35,
    "end": 543.6,
    "text": "",
    "textdich": ""
  },
  {
    "start": 540.36,
    "end": 545.8,
    "text": "Thế thì các chị em sợ nhất là cái mỡ.",
    "textdich": ""
  },
  {
    "start": 543.59,
    "end": 545.8,
    "text": "",
    "textdich": ""
  },
  {
    "start": 543.6,
    "end": 548.12,
    "text": "Thế bây giờ nó không có mỡ chứ không",
