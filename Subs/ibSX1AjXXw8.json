  },
  {
    "start": 533.35,
    "end": 535.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 533.36,
    "end": 538.16,
    "text": "Thế nhưng mà cái đạm thực cái mỡ thực",
    "textdich": ""
  },
  {
    "start": 535.67,
    "end": 538.16,
    "text": "",
    "textdich": ""
  },
  {
    "start": 535.68,
    "end": 540.36,
    "text": "vật của nó ở trong này lại rất thấp và",
