  },
  {
    "start": 522.909,
    "end": 525.68,
    "text": "",
    "textdich": ""
  },
  {
    "start": 522.919,
    "end": 527.839,
    "text": "Nhưng nhưng mà đạm thực vật thì cụ thể",
