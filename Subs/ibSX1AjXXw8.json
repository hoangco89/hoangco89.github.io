  },
  {
    "start": 525.67,
    "end": 527.839,
    "text": "",
    "textdich": ""
  },
  {
    "start": 525.68,
    "end": 533.36,
    "text": "là cái độ đen này nó cung cấp cho bạn",
    "textdich": ""
  },
  {
    "start": 527.829,
    "end": 533.36,
    "text": "",
    "textdich": ""
  },
  {
    "start": 527.839,
    "end": 535.68,
    "text": "như thế là tới gần 60 g cơ mà cao lắm.",
