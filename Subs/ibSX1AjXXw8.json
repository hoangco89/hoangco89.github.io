  },
  {
    "start": 473.71,
    "end": 479.159,
    "text": "",
    "textdich": ""
  },
  {
    "start": 473.72,
    "end": 483.319,
    "text": "đề ăn đạm động vật và đạm thực vật. Cái",
    "textdich": ""
  },
  {
    "start": 479.149,
    "end": 483.319,
    "text": "",
    "textdich": ""
  },
  {
    "start": 479.159,
    "end": 486.0,
    "text": "ăn thịt ấy thì Quỳnh Anh sợ béo. Thí dụ",
    "textdich": ""
  },
  {
    "start": 483.309,
    "end": 486.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 483.319,
    "end": 490.199,
    "text": "như là thịt lợn, thịt gà rồi cá vân vân.",
    "textdich": ""
  },
  {
    "start": 485.99,
    "end": 490.199,
    "text": "",
    "textdich": ""
  },
  {
    "start": 486.0,
    "end": 494.919,
    "text": "Ấy thì trong cái thịt ấy nó có thịt là",
    "textdich": ""
  },
  {
    "start": 490.189,
    "end": 494.919,
    "text": "",
    "textdich": ""
  },
  {
    "start": 490.199,
    "end": 499.52,
    "text": "protein nhưng mà có mỡ là ừ lipit và có",
    "textdich": ""
  },
  {
    "start": 494.909,
    "end": 499.52,
    "text": "",
    "textdich": ""
  },
  {
    "start": 494.919,
    "end": 501.84,
    "text": "cái thành phần đường tức là glycit cộng",
    "textdich": ""
  },
  {
    "start": 499.51,
    "end": 501.84,
    "text": "",
    "textdich": ""
  },
  {
    "start": 499.52,
    "end": 505.12,
    "text": "với lại các loại vitamin. Ở đây tôi chỉ",
    "textdich": ""
  },
  {
    "start": 501.83,
    "end": 505.12,
    "text": "",
    "textdich": ""
  },
  {
    "start": 501.84,
    "end": 508.52,
    "text": "bàn là nó có cái phần lipit tức là có",
    "textdich": ""
  },
  {
    "start": 505.11,
    "end": 508.52,
    "text": "",
    "textdich": ""
  },
  {
    "start": 505.12,
    "end": 512.0,
    "text": "phần mỡ. có phần mỡ mà đặc biệt là mỡ là",
    "textdich": ""
  },
  {
    "start": 508.51,
    "end": 512.0,
    "text": "",
    "textdich": ""
  },
  {
    "start": 508.52,
    "end": 514.279,
    "text": "cholesterol này nó rất tốt cho cơ thể",
    "textdich": ""
  },
  {
    "start": 511.99,
    "end": 514.279,
    "text": "",
    "textdich": ""
  },
  {
    "start": 512.0,
    "end": 516.519,
    "text": "nhưng đồng thời mặt trái của nó là làm",
    "textdich": ""
  },
  {
    "start": 514.269,
    "end": 516.519,
    "text": "",
    "textdich": ""
  },
  {
    "start": 514.279,
    "end": 519.24,
    "text": "cho các bệnh tim mạch nó phát triển, làm",
    "textdich": ""
  },
  {
    "start": 516.509,
    "end": 519.24,
    "text": "",
    "textdich": ""
  },
  {
    "start": 516.519,
    "end": 522.919,
    "text": "cho huyết áp nó phát triển vân vân. Thế",
    "textdich": ""
  },
  {
    "start": 519.23,
    "end": 522.919,
    "text": "",
    "textdich": ""
  },
  {
    "start": 519.24,
    "end": 525.68,
    "text": "là đạm động vật thì nó lại luật như vậy.",
